---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="robots" content="noindex" /><base href={base} /><title>Ongehoord</title></head
  ><body
    ><main><p>Choosing your language… <a href="en/">Continue in English</a></p></main><script
      is:inline
      set:html={`(()=>{const supported=['nl','en','ar'],fallback='en';const get=v=>{if(typeof v!=='string')return fallback;const p=v.trim().toLowerCase().split('-')[0];return supported.includes(p)?p:fallback};let saved;try{saved=localStorage.getItem('ongehoord-language')}catch{};let locale=saved&&supported.includes(get(saved))?get(saved):fallback;if(!saved){for(const value of navigator.languages||[navigator.language]){const candidate=get(value);if(candidate!==fallback||String(value).toLowerCase().startsWith('en')){locale=candidate;break}}}const base=${JSON.stringify(base)};location.replace(base+locale+'/'+location.search+location.hash)})()`}
    /></body
  >
</html>
