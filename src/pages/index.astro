---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><meta name="robots" content="noindex, nofollow" /><base href={base} /><title>
      Ongehoord
    </title></head
  ><body
    ><main>
      <p>Opening the Dutch edition… <a href="nl/">Doorgaan in het Nederlands</a></p>
    </main><script
      is:inline
      set:html={`(()=>{const base=${JSON.stringify(base)};location.replace(base+'nl/'+location.search+location.hash)})()`}
    /></body
  >
</html>
