---
import { getCollection } from 'astro:content';
import TherapyExperiencePage from '../../../../components/TherapyExperiencePage.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const [entry] = await getCollection(
  'pages',
  (page) => page.data.locale === 'nl' && page.data.slug === 'herstel/therapie',
);

if (!entry) {
  throw new Error('Missing validated content entry for /nl/herstel/therapie/.');
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath="/nl/herstel/therapie/"
>
  <TherapyExperiencePage entry={entry} />
</BaseLayout>
