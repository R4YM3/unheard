---
import { getCollection } from 'astro:content';
import HomePage from '../../components/HomePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const [entry] = await getCollection(
  'pages',
  (page) => page.data.locale === 'nl' && page.data.slug === 'home',
);

if (!entry) {
  throw new Error('Missing validated content entry for /nl/.');
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} canonicalPath="/nl/">
  <HomePage entry={entry} />
</BaseLayout>
