---
import { getCollection, render } from 'astro:content';
import ContentPage from '../../../components/ContentPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const [entry] = await getCollection(
  'pages',
  ({ data }) => data.locale === 'nl' && data.slug === 'begrippen',
);
if (!entry) throw new Error('Missing content entry: nl/begrippen');
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath="/nl/begrippen/"
>
  <ContentPage entry={entry} Content={Content} />
</BaseLayout>
