---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ontwerpwerkplaats"
  description="Interne componentwerkplaats voor Ongehoord."
  locale="nl"
  canonicalPath="/nl/ontwerp-systeem/"
  indexable={false}
  ><section class="section">
    <div class="wrap">
      <p class="eyebrow">Intern · componentwerkplaats</p><h1>Ontwerpwerkplaats</h1><p
        class="reading"
      >
        Gebruik deze pagina om componenten, toonvarianten, donkere weergave en RTL vóór gebruik in
        content te beoordelen.
      </p><p class="reading">
        <a href="nl/ontwerp-systeem/herkenning/">Varianten van het voorbeeldenblok vergelijken</a>
      </p><div class="grid">
        <article class="card">
          <p class="eyebrow">Emotiekaart</p><h2>Ik twijfel aan mezelf</h2><p>
            Een rustige ingang naar een herkenbare ervaring.
          </p><a href="nl/wat-voel-ik/ik-twijfel-aan-mezelf/">Bekijk pagina</a>
        </article><article class="card card--tension">
          <p class="eyebrow">Patroonkaart</p><h2>Een gesprek verschuift</h2><p>
            Een subtiele terracotta rand markeert spanning zonder alarmisme.
          </p>
        </article><article class="card">
          <p class="eyebrow">Hulpblok</p><h2>Direct gevaar?</h2><p>Bel 112 bij direct gevaar.</p><a
            class="button"
            href="nl/hulp-vinden/">Hulp vinden</a
          >
        </article>
      </div>
    </div>
  </section>
  <section
    class="section section--tight"
    id="pijlerkleuren"
    aria-labelledby="pijlerkleuren-heading"
  >
    <div class="wrap reading">
      <h2 id="pijlerkleuren-heading">Pijlerkleuren</h2>
      <p>
        Vergelijk de kleur en het patroon van de drie pijlers. De tweede band voor Begrijpen laat
        dezelfde link op een neutrale achtergrond zien.
      </p>
    </div>
    <div class="section section--tight section--soft section--tape">
      <div class="wrap reading">
        <h3>Voelen</h3>
        <a class="text-link" href="nl/wat-voel-ik/ik-twijfel-aan-mezelf/"
          >Waarom twijfel ik steeds aan mezelf?</a
        >
      </div>
    </div>
    <div class="section section--tight pillar--recognition">
      <div class="wrap reading">
        <h3>Herkennen</h3>
        <a class="text-link" href="nl/#perspectief">Bekijk voorbeelden van gesprekken</a>
      </div>
    </div>
    {
      ['section--tint', 'section--paper'].map((tone) => (
        <div
          class:list={[
            'section',
            'section--tight',
            tone,
            { 'pillar--understanding': tone === 'section--tint' },
          ]}
        >
          <div class="wrap reading">
            <h3>Begrijpen</h3>
            <a class="text-link" href="nl/begrijp-het/conflict-of-patroon/">
              Wanneer wordt een conflict een patroon?
            </a>
          </div>
        </div>
      ))
    }
  </section>
</BaseLayout>
