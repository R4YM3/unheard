---
import { getCollection } from 'astro:content';
import FounderStoryPage from '../../../components/FounderStoryPage.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const [entry] = await getCollection(
  'pages',
  (page) => page.data.locale === 'nl' && page.data.slug === 'mijn-verhaal',
);

if (!entry) {
  throw new Error('Missing validated content entry for /nl/mijn-verhaal/.');
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath="/nl/mijn-verhaal/"
>
  <FounderStoryPage entry={entry} />
</BaseLayout>
