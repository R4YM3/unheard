---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Words for what you feel"
  description="Recognition, understanding and practical next steps after emotional or financial abuse."
  locale="en"
  canonicalPath="/en/"
  indexable={false}
  ><section class="hero">
    <div class="wrap">
      <p class="eyebrow">Recognise · Understand · Recover</p><h1>
        For everything you feel but cannot yet put into words.
      </h1><p class="lead">
        Unheard offers a calm starting point for people affected by emotional or financial abuse,
        with particular attention to the silence many men experience.
      </p><a class="button" href="en/">Start here</a>
    </div>
  </section><section class="section">
    <div class="wrap reading">
      <h2>English content is being reviewed.</h2><p>
        The Dutch edition is currently the complete launch edition. Until a page has an approved
        translation, this English entry point avoids presenting unreviewed translations as finished
        information.
      </p>
    </div>
  </section></BaseLayout
>
