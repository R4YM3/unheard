---
import EmotionPage from '../../templates/EmotionPage.astro';
import HubPage from '../../templates/HubPage.astro';
import KnowledgePage from '../../templates/KnowledgePage.astro';
import StoryPage from '../../templates/StoryPage.astro';
import TherapyPage from '../../templates/TherapyPage.astro';
import ToolPage from '../../templates/ToolPage.astro';
import { getPublishedEntries, type RoutedEntry } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedEntries();
  return entries
    .filter((entry) => entry.data.slug !== 'home')
    .map((entry) => ({
      params: { locale: entry.data.locale, slug: entry.data.slug },
      props: { entry },
    }));
}

const { entry } = Astro.props as { entry: RoutedEntry };
---

{
  entry.collection === 'emotions' ? (
    <EmotionPage entry={entry} />
  ) : entry.collection === 'therapies' ? (
    <TherapyPage entry={entry} />
  ) : entry.collection === 'tools' ? (
    <ToolPage entry={entry} />
  ) : entry.collection === 'hubs' ? (
    <HubPage entry={entry} />
  ) : entry.collection === 'story' ? (
    <StoryPage entry={entry} />
  ) : (
    <KnowledgePage entry={entry} />
  )
}
