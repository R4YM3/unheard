---
/**
 * Optional reflection questions. Answers stay in the page: nothing is stored, sent or
 * printed unless the reader explicitly opts in to printing them.
 */
import { localeFromPath } from '../i18n/config';
import { ui } from '../i18n/ui';
interface Props {
  reflection: { heading?: string; questions: string[]; note?: string; writable: boolean };
  id?: string;
  /** Start closed: the questions open on request, so a long page stays light. */
  collapsed?: boolean;
}
const { reflection, id = 'reflectie', collapsed = false } = Astro.props;
const Box = collapsed ? 'details' : 'div';
const t = ui(localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL));
const heading = reflection.heading ?? t.reflectionHeading;
---

<section class="section" aria-labelledby={`${id}-heading`} id={id}>
  <div class="wrap reading">
    <Box class:list={['reflection', { 'reflection--collapsed': collapsed }]} data-print-answers>
      {
        collapsed ? (
          <summary>
            <span class="eyebrow">{t.optional}</span>
            <h2 id={`${id}-heading`}>{heading}</h2>
          </summary>
        ) : (
          <>
            <p class="eyebrow">{t.optional}</p>
            <h2 id={`${id}-heading`}>{heading}</h2>
          </>
        )
      }
      {reflection.note && <p>{reflection.note}</p>}
      {
        reflection.writable ? (
          <form
            class="reflection-form"
            method="dialog"
            autocomplete="off"
            aria-describedby={`${id}-privacy`}
          >
            {reflection.questions.map((question, index) => (
              <div>
                <label for={`${id}-q${index}`}>{question}</label>
                <textarea
                  id={`${id}-q${index}`}
                  rows="3"
                  autocomplete="off"
                  spellcheck="false"
                  autocapitalize="off"
                />
                <span class="print-lines" style="--lines: 3" aria-hidden="true" />
              </div>
            ))}
            <div class="form-row">
              <button class="button button--quiet" type="reset">
                {t.clearAnswers}
              </button>
              <label class="check-label print-toggle">
                <input type="checkbox" /> {t.printAnswers}
              </label>
            </div>
          </form>
        ) : (
          <ol>
            {reflection.questions.map((question) => (
              <li>{question}</li>
            ))}
          </ol>
        )
      }
      <p class="note" id={`${id}-privacy`}>
        {reflection.writable ? t.reflectionWritableNote : t.reflectionThinkNote}
      </p>
    </Box>
  </div>
</section>
