---
import { localeFromPath } from '../i18n/config';
import { ui } from '../i18n/ui';
export interface GridItem {
  eyebrow?: string;
  title: string;
  text?: string;
  href?: string;
  label?: string;
  tone?: 'neutral' | 'safe' | 'tension' | 'alert' | 'story';
}
interface Props {
  items: GridItem[];
  columns?: 2 | 3;
  headingLevel?: 3 | 4;
  tone?: GridItem['tone'];
}
const { items, columns = 3, headingLevel = 3, tone = 'neutral' } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
/* A label that every card in the list shares says nothing: show labels only in mixed lists. */
const labels = new Set(items.map((item) => item.eyebrow ?? ''));
const showLabels = labels.size > 1;
const t = ui(localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL));
---

<div class:list={['grid', `grid--${columns}`]}>
  {
    items.map((item) => {
      const classes = ['card', `card--${item.tone ?? tone}`];
      const inner = (
        <>
          {showLabels && item.eyebrow && <p class="eyebrow">{item.eyebrow}</p>}
          <Heading>{item.title}</Heading>
          {item.text && <p>{item.text}</p>}
          {item.href && (
            <span class="card-link-label" aria-hidden="true">
              {item.label ?? t.readOn} →
            </span>
          )}
        </>
      );
      return item.href ? (
        <a class:list={classes} href={item.href}>
          {inner}
        </a>
      ) : (
        <article class:list={classes}>{inner}</article>
      );
    })
  }
</div>
