---
/**
 * Variant B-light of the recognition block: the same scenarios as PerspectiveSwitch, as
 * four situation headings with one level of disclosure. Closed, a situation shows its
 * heading and what you hear; opened, it adds what you feel and the context. Native
 * <details>, so it works without JavaScript; print opens every situation.
 */
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Scenario {
  label: string;
  outside: string;
  inside: string;
  context: string;
  followUp?: { href: string; label: string };
}
interface Props {
  scenarios: Scenario[];
  id?: string;
  heading?: string;
  intro?: string;
  locale?: Locale;
}
const { scenarios, id = 'situaties', locale = 'nl', ...rest } = Astro.props;
const t = ui(locale);
const heading = rest.heading ?? t.perspectiveHeading;
const intro = rest.intro ?? t.perspectiveIntro;
const unquote = (text: string) => text.trim().replace(/^["“„‘']+|["”’']+$/g, '');
---

<section class="section section--block pv-section" aria-labelledby={`${id}-heading`} id={id}>
  <div class="wrap">
    <div class="pv-head">
      {locale === 'nl' && <p class="eyebrow">Voorbeeld</p>}
      <h2 id={`${id}-heading`}>{heading}</h2>
      <p>{intro}</p>
    </div>
    <ul class="pvs">
      {
        scenarios.map((scenario) => (
          <li>
            <details class="pvs-item">
              <summary>
                <h3 class="pvs-item__title">{scenario.label}</h3>
                <p class="pvs-item__heard">
                  <span class="pvs-item__label">{t.youHear}</span>
                  <q>{unquote(scenario.outside)}</q>
                </p>
              </summary>
              <div class="pvs-item__body">
                <p class="pvs-item__felt">
                  <span class="pvs-item__label">{t.youFeel}</span>
                  <span>{scenario.inside}</span>
                </p>
                <p class="pv-context">{scenario.context}</p>
                {scenario.followUp && (
                  <p>
                    <a class="text-link" href={scenario.followUp.href}>
                      {scenario.followUp.label}
                    </a>
                  </p>
                )}
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pvs {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 52rem) {
    .pvs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  .pvs li {
    margin: 0;
  }
  .pvs-item {
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 0.25rem);
    background: var(--surface);
  }
  .pvs-item[open] {
    border-color: var(--border-strong);
  }
  .pvs-item summary {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.15rem, 3vw, 1.6rem);
    padding-inline-end: 3.5rem;
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
  }
  .pvs-item summary::-webkit-details-marker {
    display: none;
  }
  .pvs-item summary::after {
    content: '';
    position: absolute;
    inset-block-start: clamp(1.35rem, 3vw, 1.8rem);
    inset-inline-end: clamp(1.15rem, 3vw, 1.6rem);
    width: 0.6rem;
    height: 0.6rem;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(45deg);
  }
  .pvs-item[open] summary::after {
    transform: rotate(225deg);
  }
  .pvs-item summary:hover .pvs-item__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .pvs-item__title {
    margin: 0;
    font-size: 1.2rem;
  }
  .pvs-item__heard,
  .pvs-item__felt {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 600;
    line-height: 1.3;
  }
  .pvs-item__heard q {
    quotes: '“' '”';
  }
  .pvs-item__felt {
    font-style: italic;
    font-weight: 400;
    color: var(--hero-eyebrow);
  }
  .pvs-item__label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pvs-item__felt .pvs-item__label {
    color: var(--hero-eyebrow);
  }
  .pvs-item__body {
    padding: 0 clamp(1.15rem, 3vw, 1.6rem) clamp(1.15rem, 3vw, 1.6rem);
  }
  .pvs-item__body .pv-context {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  @media print {
    .pvs {
      display: block;
    }
    .pvs-item {
      margin: 3mm 0;
      border: 1px solid #777 !important;
      background: #fff !important;
      color: #000 !important;
      break-inside: avoid;
    }
    .pvs-item::details-content {
      content-visibility: visible;
      display: block;
    }
    .pvs-item summary::after {
      display: none;
    }
    .pvs-item__felt,
    .pvs-item__label {
      color: #000 !important;
    }
  }
</style>
