---
/** Renders editorial internal links and highlights founder-review markers. No raw HTML. */
import { inlineParts } from '../lib/inline-text';
interface Props {
  text: string;
}
const MARKER = '[OPRICHTER REVIEW NODIG]';
const parts = Astro.props.text.split(MARKER);
---

{
  parts.map((part, index) => (
    <>
      {index > 0 && <mark class="review-marker">{MARKER}</mark>}
      {inlineParts(part).map((segment) =>
        segment.href ? (
          <a class="inline-link" href={segment.href}>
            {segment.text}
          </a>
        ) : (
          segment.text
        ),
      )}
    </>
  ))
}
