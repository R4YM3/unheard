---
/**
 * What is said and what it does inside, shown together. Every scenario is rendered in HTML
 * and readable without JavaScript and in print (all scenarios stacked). With JavaScript the
 * reader picks one scenario at a time with plain toggle buttons; both sides stay visible,
 * because seeing them side by side is the point.
 */
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Scenario {
  label: string;
  outside: string;
  inside: string;
  context: string;
  followUp?: { href: string; label: string };
}
interface Props {
  scenarios: Scenario[];
  id?: string;
  eyebrow?: string;
  heading?: string;
  intro?: string;
  outsideLabel?: string;
  insideLabel?: string;
  locale?: Locale;
  /**
   * 'stacked' (reference): what you hear above what you feel.
   * 'split' (variant A): side by side on wide screens, stacked on mobile; direct buttons only.
   */
  layout?: 'stacked' | 'split';
}
const { scenarios, id = 'perspectief', locale = 'nl', layout = 'stacked', ...rest } = Astro.props;
const t = ui(locale);
const heading = rest.heading ?? t.perspectiveHeading;
const intro = rest.intro ?? t.perspectiveIntro;
const outsideLabel = rest.outsideLabel ?? t.youHear;
const insideLabel = rest.insideLabel ?? t.youFeel;
/* Content may already carry its own quotation marks; <q> adds them once. */
const unquote = (text: string) => text.trim().replace(/^["“„‘']+|["”’']+$/g, '');
---

<section
  class="section section--tint section--tape pv-section"
  aria-labelledby={`${id}-heading`}
  id={id}
>
  <div class="wrap">
    <div class="pv-head">
      <h2 id={`${id}-heading`}>{heading}</h2>
      <p>{intro}</p>
    </div>
    <div
      class:list={[
        'pv',
        `pv--${layout}`,
        { 'pv--many': layout === 'stacked' && scenarios.length > 3 },
      ]}
      data-pv
    >
      {
        scenarios.length > 1 && (
          <div class="pv-choice" role="group" aria-label={t.chooseExample} hidden data-pv-choice>
            {scenarios.map((scenario, index) => (
              <button
                type="button"
                data-pv-scene={index}
                aria-controls={`${id}-scene-${index}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {scenario.label}
              </button>
            ))}
          </div>
        )
      }
      {
        layout === 'stacked' && scenarios.length > 3 && (
          <label class="pv-select" hidden data-pv-select-label>
            <span>{t.chooseExample}</span>
            <select
              data-pv-select
              aria-controls={scenarios.map((_, index) => `${id}-scene-${index}`).join(' ')}
            >
              {scenarios.map((scenario, index) => (
                <option value={index}>{scenario.label}</option>
              ))}
            </select>
          </label>
        )
      }
      {
        scenarios.map((scenario, index) => (
          <article class="pv-scene" id={`${id}-scene-${index}`} data-pv-panel={index}>
            <h3 class="pv-scene__title">{scenario.label}</h3>
            <dl class="pv-lines">
              <div class="pv-line pv-line--outside">
                <dt>{outsideLabel}</dt>
                <dd>
                  <q>{unquote(scenario.outside)}</q>
                </dd>
              </div>
              <div class="pv-line pv-line--inside">
                <dt>{insideLabel}</dt>
                <dd>{scenario.inside}</dd>
              </div>
            </dl>
            <p class="pv-context">{scenario.context}</p>
            {scenario.followUp && (
              <p>
                <a class="text-link" href={scenario.followUp.href}>
                  {scenario.followUp.label}
                </a>
              </p>
            )}
          </article>
        ))
      }
      {
        scenarios.length > 1 && (
          <p
            class="sr-only"
            role="status"
            data-pv-status
            data-labels={JSON.stringify(
              scenarios.map((scenario) => t.shownExample(scenario.label)),
            )}
          />
        )
      }
    </div>
  </div>
</section>

<script>
  const enhance = (root: HTMLElement) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-pv-scene]')];
    const scenes = [...root.querySelectorAll<HTMLElement>('[data-pv-panel]')];
    if (buttons.length < 2 || scenes.length !== buttons.length) return;
    const select = root.querySelector<HTMLSelectElement>('[data-pv-select]');
    const status = root.querySelector<HTMLElement>('[data-pv-status]');
    const labels: string[] = JSON.parse(status?.dataset.labels ?? '[]');
    const show = (scene: number, announce = false) => {
      // A short status names the example; the example itself is not a live region.
      if (status && announce) status.textContent = labels[scene] ?? '';
      if (select) select.value = String(scene);
      buttons.forEach((button, index) =>
        button.setAttribute('aria-pressed', String(index === scene)),
      );
      scenes.forEach((section, index) => {
        section.hidden = index !== scene;
      });
    };
    buttons.forEach((button) =>
      button.addEventListener('click', () => show(Number(button.dataset.pvScene), true)),
    );
    select?.addEventListener('change', () => show(Number(select.value), true));
    root.querySelector<HTMLElement>('[data-pv-select-label]')?.removeAttribute('hidden');
    root.querySelector<HTMLElement>('[data-pv-choice]')?.removeAttribute('hidden');
    root.dataset.enhanced = '';
    const showLinkedScene = () => {
      const linkedScene = scenes.findIndex((scene) => `#${scene.id}` === window.location.hash);
      if (linkedScene < 0) return false;
      show(linkedScene);
      scenes[linkedScene]?.scrollIntoView();
      return true;
    };
    window.addEventListener('hashchange', showLinkedScene);
    if (!showLinkedScene()) show(0);
  };

  document.querySelectorAll<HTMLElement>('[data-pv]').forEach(enhance);
</script>

<style>
  .pv-select {
    display: none;
  }
  @media (max-width: 40rem) {
    .pv--many[data-enhanced] .pv-choice {
      display: none;
    }
    .pv--many[data-enhanced] .pv-select {
      display: grid;
      gap: 0.5rem;
      margin-block-end: 1.25rem;
      font-weight: 600;
    }
    select {
      width: 100%;
      min-width: 0;
      min-height: 2.75rem;
      padding: 0.65rem 0.8rem;
      border: 1.5px solid var(--border-strong);
      border-radius: var(--radius-sm);
      background: var(--surface);
      color: var(--text);
      font: inherit;
    }
  }
  @media print {
    .pv-select {
      display: none !important;
    }
  }
</style>
