---
import type { CollectionEntry } from 'astro:content';
import PerspectiveLines from './PerspectiveLines.astro';

interface Props {
  scenarios: CollectionEntry<'hubs'>['data']['scenarios'];
}
const { scenarios } = Astro.props;
---

<div class="hero-conversations" data-hero-conversations>
  <div class="hero-conversations__stage">
    {
      scenarios.map((scenario, index) => (
        <div data-conversation-frame hidden={index !== 0}>
          <PerspectiveLines
            outside={scenario.outside}
            inside={scenario.inside}
            outsideLabel="Je hoort"
            insideLabel="Je voelt"
          />
          {scenario.followUp && (
            <a class="text-link hero-conversations__link" href={scenario.followUp.href}>
              {scenario.followUp.label}
            </a>
          )}
        </div>
      ))
    }
  </div>
  <div class="hero-conversations__controls" data-conversation-controls hidden>
    <button type="button" data-conversation-prev aria-label="Vorig voorbeeld" title="Vorige">
      <span class="arrow-icon arrow-icon--prev" aria-hidden="true"></span>
    </button>
    <div class="hero-conversations__dots">
      {
        scenarios.map((scenario, index) => (
          <button type="button" class="hero-conversations__dot" data-conversation-dot={index}>
            <span class="sr-only">
              Voorbeeld {index + 1}: {scenario.label}
            </span>
          </button>
        ))
      }
    </div>
    <p class="hero-conversations__count" data-conversation-count aria-live="off">
      1 van {scenarios.length} · {scenarios[0]?.label}
    </p>
    <button
      type="button"
      data-conversation-toggle
      aria-label="Pauzeer voorbeelden"
      title="Pauzeren"
    >
      <span class="play-icon" aria-hidden="true" hidden></span>
      <span class="pause-icon" aria-hidden="true"></span>
    </button>
    <button type="button" data-conversation-next aria-label="Volgend voorbeeld" title="Volgende">
      <span class="arrow-icon arrow-icon--next" aria-hidden="true"></span>
    </button>
  </div>
</div>

<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const group of document.querySelectorAll<HTMLElement>('[data-hero-conversations]')) {
    const dots = [...group.querySelectorAll<HTMLButtonElement>('[data-conversation-dot]')];
    const count = group.querySelector<HTMLElement>('[data-conversation-count]');
    const labels = dots.map((dot) => dot.textContent?.replace(/^\s*Voorbeeld \d+:\s*/, '').trim());
    const frames = [...group.querySelectorAll<HTMLElement>('[data-conversation-frame]')];
    const controls = group.querySelector<HTMLElement>('[data-conversation-controls]');
    const toggle = group.querySelector<HTMLButtonElement>('[data-conversation-toggle]');
    const back = group.querySelector<HTMLButtonElement>('[data-conversation-prev]');
    const next = group.querySelector<HTMLButtonElement>('[data-conversation-next]');
    const playIcon = toggle?.querySelector<HTMLElement>('.play-icon');
    const pauseIcon = toggle?.querySelector<HTMLElement>('.pause-icon');
    if (!controls || !toggle || !back || !next || !playIcon || !pauseIcon || frames.length < 2)
      continue;

    let current = 0;
    let paused = false;
    let switching = false;
    let timer: number | undefined;
    const phone = matchMedia('(max-width: 52rem)');

    const updatePlayback = () => {
      clearInterval(timer);
      controls.hidden = false;
      toggle.hidden = motion.matches;
      toggle.setAttribute('aria-label', paused ? 'Speel voorbeelden af' : 'Pauzeer voorbeelden');
      toggle.title = paused ? 'Afspelen' : 'Pauzeren';
      playIcon.hidden = !paused;
      pauseIcon.hidden = paused;
      if (paused || motion.matches || switching) return;

      timer = window.setInterval(() => {
        if (
          document.hidden ||
          group.getClientRects().length === 0 ||
          frames[current].contains(document.activeElement)
        )
          return;
        advance(1, undefined, false);
      }, 6000);
    };

    const mark = (byUser: boolean) => {
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (!count) return;
      /* Automatic turns stay silent; a turn the reader asked for is announced. */
      count.setAttribute('aria-live', byUser ? 'polite' : 'off');
      count.textContent = `${current + 1} van ${frames.length} · ${labels[current] ?? ''}`;
    };

    const advance = (direction: number, target?: number, byUser = true) => {
      if (switching) return;
      const nextIndex = target ?? (current + direction + frames.length) % frames.length;
      if (nextIndex === current) return;
      clearInterval(timer);
      const outgoing = frames[current];

      const showNext = () => {
        outgoing.hidden = true;
        outgoing.inert = false;
        outgoing.classList.remove('conversation-exit', 'conversation-exit--back');

        current = nextIndex;
        const incoming = frames[current];
        incoming.classList.remove('conversation-enter', 'conversation-enter--back');
        if (!motion.matches) {
          void incoming.offsetWidth;
          incoming.classList.add('conversation-enter');
          incoming.classList.toggle('conversation-enter--back', direction < 0);
        }
        incoming.hidden = false;
        switching = false;
        mark(byUser);
        updatePlayback();
      };

      if (motion.matches) {
        showNext();
        return;
      }

      /* The current conversation steps aside, then the next one comes in, shakes and gets
         its answer. */
      switching = true;
      outgoing.classList.remove('conversation-enter', 'conversation-enter--back');
      outgoing.classList.add('conversation-exit');
      outgoing.classList.toggle('conversation-exit--back', direction < 0);
      outgoing.inert = true;
      window.setTimeout(showNext, phone.matches ? 420 : 300);
    };

    back.addEventListener('click', () => advance(-1));
    next.addEventListener('click', () => advance(1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => advance(i > current ? 1 : -1, i)));

    /* On a phone the card can be swiped sideways. */
    let startX: number | undefined;
    let startY = 0;
    group.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'touch') return;
      startX = event.clientX;
      startY = event.clientY;
    });
    group.addEventListener('pointerup', (event) => {
      if (startX === undefined) return;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      startX = undefined;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.5) advance(dx < 0 ? 1 : -1);
    });
    group.addEventListener('pointercancel', () => {
      startX = undefined;
    });
    mark(false);
    toggle.addEventListener('click', () => {
      paused = !paused;
      updatePlayback();
    });
    motion.addEventListener('change', updatePlayback);
    updatePlayback();
  }
</script>

<style>
  .hero-conversations {
    --bubble-gap: 1.25rem;
    position: relative;
    display: grid;
    min-width: 0;
  }

  .hero-conversations__stage {
    display: grid;
    overflow: clip;
    align-content: start;
    padding: 0.75rem;
    margin-inline: -0.75rem;
  }

  /* All conversations share one grid cell, so the longest one sets the height and nothing
     below moves when the conversation changes. */
  [data-conversation-frame] {
    grid-area: 1 / 1;
    align-self: start;
  }

  [data-conversation-frame][hidden] {
    display: block !important;
    visibility: hidden;
  }

  .hero-conversations :global(.pv-line) {
    grid-template-columns: minmax(0, 1fr);
    width: fit-content;
    max-width: min(92%, 24rem);
    padding: 1rem 1.25rem;
    border-radius: 1.125rem;
    box-sizing: border-box;
  }

  .hero-conversations :global(.pv-line dd) {
    font-size: clamp(1.1rem, 1.5vw, 1.45rem);
    text-wrap: pretty;
  }

  /* As on the canvas: two solid bubbles, both read from the start. What is said sits on the
     start side, what it does inside on the end side, in a quiet green that differs from the
     rose of the Begrijpen chapter. */
  .hero-conversations :global(.pv-line--outside) {
    justify-self: start;
    border: 1px solid var(--safe-border);
    border-end-start-radius: 0.25rem;
    background: var(--surface);
  }

  .hero-conversations :global(.pv-line--inside) {
    justify-self: end;
    margin-block-start: var(--bubble-gap);
    border: 1px solid var(--safe-border);
    border-end-end-radius: 0.25rem;
    background: var(--badge);
  }

  .hero-conversations__link {
    display: block;
    width: fit-content;
    margin-block-start: 1rem;
    margin-inline-start: auto;
    text-align: end;
  }

  /* Controls as in "Wat je hoort. Wat je voelt.": arrows, dots and pause in one row. */
  .hero-conversations__controls:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-block-start: 1rem;
  }

  .hero-conversations__dots {
    display: flex;
  }

  .hero-conversations__count {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  button:not([hidden]) {
    display: inline-grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 1.5px solid var(--text);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  button:hover {
    background: var(--surface);
  }

  button:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  [data-conversation-toggle]:not([hidden]) {
    border-color: transparent;
  }

  button.hero-conversations__dot:not([hidden]) {
    width: 1.5rem;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .hero-conversations__dot::before {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--border-strong);
    content: '';
    transition: width 200ms ease;
  }

  .hero-conversations__dot[aria-current='true']::before {
    width: 1.25rem;
    background: var(--link);
  }

  .arrow-icon {
    width: 0.5rem;
    height: 0.5rem;
    border-block-start: 2px solid currentColor;
    border-inline-end: 2px solid currentColor;
  }

  .arrow-icon--prev {
    transform: translateX(1px) rotate(-135deg);
  }

  .arrow-icon--next {
    transform: translateX(-1px) rotate(45deg);
  }

  .play-icon {
    width: 0.625rem;
    height: 0.75rem;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    transform: translateX(1px);
  }

  .pause-icon {
    width: 0.625rem;
    height: 0.75rem;
    border-inline: 0.1875rem solid currentColor;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    [data-conversation-frame]:not([hidden]):not(.conversation-exit) :global(.pv-line--outside) {
      animation: hero-message-shake 380ms ease-in-out;
    }

    [data-conversation-frame]:not([hidden]):not(.conversation-exit) :global(.pv-line--inside),
    [data-conversation-frame]:not([hidden]):not(.conversation-exit) .hero-conversations__link {
      animation: hero-message-in 280ms ease-out 240ms both;
    }
  }

  /* Wide screens: like a chat, the next conversation comes in from above and the current one
     moves down and out; going back, it comes from below. Then it shakes and gets its answer. */
  @media screen and (width > 52rem) and (prefers-reduced-motion: no-preference) {
    .conversation-exit {
      animation: hero-chat-out 300ms ease-in both;
    }

    .conversation-exit--back {
      animation-name: hero-chat-out-back;
    }

    .conversation-enter {
      animation: hero-chat-in 420ms ease-out both;
    }

    .conversation-enter--back {
      animation-name: hero-chat-in-back;
    }

    .conversation-enter:not(.conversation-exit) :global(.pv-line--outside) {
      animation: hero-message-shake 380ms ease-in-out 140ms;
    }

    .conversation-enter:not(.conversation-exit) :global(.pv-line--inside),
    .conversation-enter:not(.conversation-exit) .hero-conversations__link {
      animation: hero-message-in 300ms ease-out 440ms both;
    }
  }

  @keyframes hero-chat-out {
    to {
      opacity: 0;
      transform: translateY(2rem);
    }
  }

  @keyframes hero-chat-out-back {
    to {
      opacity: 0;
      transform: translateY(-2rem);
    }
  }

  @keyframes hero-chat-in {
    from {
      opacity: 0;
      transform: translateY(-2rem);
    }
  }

  @keyframes hero-chat-in-back {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
  }

  @keyframes hero-message-shake {
    18% {
      transform: rotate(-3deg);
    }
    36% {
      transform: rotate(2.5deg);
    }
    54% {
      transform: rotate(-1.75deg);
    }
    72% {
      transform: rotate(1deg);
    }
  }

  @keyframes hero-message-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }

  /* Wide screens: the bubbles are centred as one stack in the hero's height; the controls
     hang centred below them, outside that measure. The arrows only show while the pointer
     is on the chat or focus is in it, so a keyboard reader always finds them. */
  @media screen and (width > 52rem) {
    .hero-conversations__stage {
      align-content: center;
    }

    [data-conversation-frame] {
      align-self: center;
    }

    .hero-conversations__controls:not([hidden]) {
      position: absolute;
      inset-block-start: 100%;
      inset-inline: 0;
      justify-content: center;
      margin-block-start: 0.25rem;
    }

    .hero-conversations__controls :is([data-conversation-prev], [data-conversation-next]) {
      opacity: 0;
      transition: opacity 160ms ease;
    }

    .hero-conversations:is(:hover, :focus-within)
      .hero-conversations__controls
      :is([data-conversation-prev], [data-conversation-next]) {
      opacity: 1;
    }
  }

  @media screen and (width > 52rem) and (hover: none) {
    .hero-conversations__controls :is([data-conversation-prev], [data-conversation-next]) {
      opacity: 1;
    }
  }

  /* Phone (Voorstel 1): the conversation is one card below the heading, with two solid
     bubbles, dots and a count. The card can be swiped; the dots and pause stay as buttons. */
  @media screen and (max-width: 52rem) {
    .hero-conversations {
      padding: 0.875rem;
      border: 1px solid var(--safe-border);
      border-radius: 1.125rem;
      background: var(--surface);
    }

    .hero-conversations__stage {
      padding: 0;
      margin: 0;
    }

    .hero-conversations :global(.pv-line) {
      max-width: 88%;
      padding: 0.625rem 0.875rem;
    }

    .hero-conversations :global(.pv-line dd) {
      font-size: 1.0625rem;
    }

    .hero-conversations :global(.pv-line--outside) {
      border-radius: 1rem 1rem 1rem 0.25rem;
      background: var(--bg);
    }

    .hero-conversations :global(.pv-line--inside) {
      margin-block-start: 0.625rem;
      border-radius: 1rem 1rem 0.25rem 1rem;
      background: var(--badge);
    }

    .hero-conversations__link {
      margin-block-start: 0.75rem;
    }

    .hero-conversations__controls:not([hidden]) {
      justify-content: space-between;
      gap: 0.25rem;
      margin-block-start: 0.5rem;
    }

    .hero-conversations__controls [data-conversation-prev],
    .hero-conversations__controls [data-conversation-next] {
      display: none;
    }

    .hero-conversations__count {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      flex: 1;
      margin: 0;
      color: var(--muted);
      font-size: 0.875rem;
      text-align: end;
    }

    button:not([hidden]) {
      border-color: transparent;
    }

    button:hover {
      background: transparent;
    }
  }

  @media screen and (max-width: 52rem) and (prefers-reduced-motion: no-preference) {
    .conversation-exit {
      animation: hero-chat-fade-out 260ms ease-in both;
    }
  }

  @keyframes hero-chat-fade-out {
    to {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media print {
    .hero-conversations {
      display: none;
    }
  }
</style>
