---
import { formatDate, isoDate } from '../lib/content';
import { localeFromPath } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  sources: Array<{
    label: string;
    url: string;
    publisher?: string;
    checkedAt?: Date;
    note?: string;
  }>;
}
const { sources } = Astro.props;
const locale = localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL);
const t = ui(locale);
---

<section class="section section--tight source-list" aria-labelledby="sources-heading">
  <div class="wrap reading">
    <h2 id="sources-heading">{t.sources}</h2>
    {
      sources.length > 0 ? (
        <ol>
          {sources.map((source) => (
            <li>
              <a href={source.url} rel="noopener">
                {source.label}
              </a>
              {source.publisher && <>, {source.publisher}</>}
              {source.checkedAt && (
                <>
                  {' '}
                  · {t.checkedOn}{' '}
                  <time datetime={isoDate(source.checkedAt)}>
                    {formatDate(source.checkedAt, locale)}
                  </time>
                </>
              )}
              {source.note && <span class="note"> — {source.note}</span>}
            </li>
          ))}
        </ol>
      ) : (
        <p class="note">{t.noSources}</p>
      )
    }
  </div>
</section>
