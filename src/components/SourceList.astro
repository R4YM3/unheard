---
interface Source {
  label: string;
  url: string;
}
interface Props {
  sources: Source[];
}
const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section class="section section--soft" aria-labelledby="sources-heading">
      <div class="wrap reading">
        <h2 id="sources-heading">Bronnen</h2>
        <ul>
          {sources.map((source) => (
            <li>
              <a href={source.url}>{source.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
