<label class="theme-toggle"
  >Weergave <select data-theme-select aria-label="Weergave"
    ><option value="system">Systeem</option><option value="light">Licht</option><option value="dark"
      >Donker</option
    ></select
  ></label
>
<script is:inline>
  {
    `(()=>{const s=document.querySelector('[data-theme-select]');if(!s)return;const saved=localStorage.getItem('ongehoord-theme')||'system';s.value=saved;s.addEventListener('change',()=>{const v=s.value;localStorage.setItem('ongehoord-theme',v);document.documentElement.dataset.theme=v==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):v})})()`;
  }
</script>
