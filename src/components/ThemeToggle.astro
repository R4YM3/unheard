---
/**
 * Light/dark switch in the header. Until the reader chooses, the site follows the device
 * setting; the choice is then remembered on this device only. aria-pressed reports whether
 * dark mode is on. Without JavaScript the button stays hidden and the device setting applies.
 */
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
---

<button
  hidden
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  aria-label={t.darkMode}
  title={t.darkMode}
>
  <svg data-theme-icon="to-dark" aria-hidden="true" viewBox="0 0 24 24" focusable="false"
    ><path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z"></path></svg
  >
  <svg data-theme-icon="to-light" aria-hidden="true" viewBox="0 0 24 24" focusable="false"
    ><circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path></svg
  >
</button>
<script
  is:inline
  set:html={`(()=>{const button=document.querySelector('[data-theme-toggle]');if(!button)return;const key='ongehoord-theme';const media=matchMedia('(prefers-color-scheme: dark)');const stored=()=>{try{const v=localStorage.getItem(key);return v==='light'||v==='dark'?v:null}catch{return null}};const current=()=>stored()??(media.matches?'dark':'light');const apply=(theme)=>{document.documentElement.dataset.theme=theme;button.setAttribute('aria-pressed',String(theme==='dark'))};apply(current());button.hidden=false;button.addEventListener('click',()=>{const theme=current()==='dark'?'light':'dark';try{localStorage.setItem(key,theme)}catch{}apply(theme)});media.addEventListener('change',()=>{if(!stored())apply(current())})})()`}
/>
