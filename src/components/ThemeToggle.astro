---
interface Props {
  locale: 'nl' | 'en' | 'ar';
}
const { locale } = Astro.props;
const labels = {
  nl: {
    setting: 'Weergave',
    activate: 'Klik voor',
    names: { light: 'licht', dark: 'donker', system: 'systeem' },
  },
  en: {
    setting: 'Appearance',
    activate: 'Activate',
    names: { light: 'light', dark: 'dark', system: 'system' },
  },
  ar: {
    setting: 'المظهر',
    activate: 'اضغط لاختيار',
    names: { light: 'فاتح', dark: 'داكن', system: 'النظام' },
  },
};
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label={`${labels[locale].setting}: ${labels[locale].names.system}`}
  title={`${labels[locale].setting}: ${labels[locale].names.system}`}
>
  <svg data-theme-icon="light" aria-hidden="true" viewBox="0 0 24 24" focusable="false"
    ><circle cx="12" cy="12" r="4"></circle><path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path></svg
  >
  <svg data-theme-icon="dark" aria-hidden="true" viewBox="0 0 24 24" focusable="false"
    ><path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z"></path></svg
  >
  <svg data-theme-icon="system" aria-hidden="true" viewBox="0 0 24 24" focusable="false"
    ><rect x="3" y="4" width="18" height="12" rx="1.5"></rect><path d="M8 20h8M12 16v4"></path></svg
  >
</button>
<script
  is:inline
  set:html={`(()=>{const button=document.querySelector('[data-theme-toggle]');if(!button)return;const key='ongehoord-theme';const media=matchMedia('(prefers-color-scheme: dark)');const labels=${JSON.stringify(labels[locale])};const next={light:'dark',dark:'system',system:'light'};const stored=()=>{try{const value=localStorage.getItem(key);return value==='light'||value==='dark'||value==='system'?value:'system'}catch{return'system'}};const apply=(choice)=>{const theme=choice==='system'?(media.matches?'dark':'light'):choice;document.documentElement.dataset.theme=theme;button.dataset.themeChoice=choice;const label=labels.setting+': '+labels.names[choice]+'. '+labels.activate+' '+labels.names[next[choice]];button.setAttribute('aria-label',label);button.title=label};let choice=stored();apply(choice);button.addEventListener('click',()=>{choice=next[choice];try{localStorage.setItem(key,choice)}catch{}apply(choice)});media.addEventListener('change',()=>{if(choice==='system')apply(choice)})})()`}
/>
