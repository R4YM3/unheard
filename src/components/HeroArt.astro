---
/**
 * The image at the top of a page, always in the same arched frame. With a photo for the slot
 * (src/assets/photos/<slot>.*) the photo fills the frame; without one a quiet, decorative
 * landscape in the site's own colours stands in. The landscape follows light/dark mode and is
 * hidden from assistive technology, because it carries no information.
 */
import { Image } from 'astro:assets';
import { photoFor, type PhotoSlot } from '../lib/photos';

interface Props {
  slot: PhotoSlot;
  /** The home image is the largest element above the fold: load it eagerly. */
  priority?: boolean;
}
const { slot, priority = false } = Astro.props;
const photo = photoFor(slot);

/* Each page gets its own composition: where the sun sits and how the hills fall. */
const scenes: Record<PhotoSlot, { sun: [number, number, number]; hills: string[] }> = {
  home: {
    sun: [270, 210, 62],
    hills: [
      'M0 330 C 90 280 170 300 250 330 S 400 360 400 340 V 500 H 0 Z',
      'M0 390 C 110 340 210 360 300 395 S 400 410 400 400 V 500 H 0 Z',
      'M0 440 C 120 410 260 420 400 450 V 500 H 0 Z',
    ],
  },
  'mijn-verhaal': {
    sun: [120, 190, 48],
    hills: [
      'M0 350 C 120 300 220 330 400 300 V 500 H 0 Z',
      'M0 410 C 140 380 250 360 400 390 V 500 H 0 Z',
      'M170 500 C 190 450 210 420 205 360 C 215 420 240 455 260 500 Z',
    ],
  },
  'wat-voel-ik': {
    sun: [200, 200, 70],
    hills: [
      'M0 360 C 100 320 300 320 400 360 V 500 H 0 Z',
      'M0 420 C 130 390 270 390 400 420 V 500 H 0 Z',
      'M0 465 C 140 450 260 450 400 465 V 500 H 0 Z',
    ],
  },
  'begrijp-het': {
    sun: [300, 170, 44],
    hills: [
      'M0 320 L 110 250 L 200 310 L 290 240 L 400 300 V 500 H 0 Z',
      'M0 400 C 120 360 260 380 400 370 V 500 H 0 Z',
      'M0 450 C 150 430 280 440 400 455 V 500 H 0 Z',
    ],
  },
  herstel: {
    sun: [140, 230, 56],
    hills: [
      'M0 340 C 130 300 230 280 400 320 V 500 H 0 Z',
      'M0 400 C 120 370 280 390 400 380 V 500 H 0 Z',
      'M195 470 C 195 420 200 390 200 360 M200 400 C 220 380 240 378 255 384 M200 425 C 180 405 160 402 146 408',
    ],
  },
  hulpmiddelen: {
    sun: [250, 180, 50],
    hills: [
      'M0 350 C 100 330 200 300 400 340 V 500 H 0 Z',
      'M0 405 C 150 385 250 395 400 410 V 500 H 0 Z',
      'M0 455 C 120 440 300 445 400 460 V 500 H 0 Z',
    ],
  },
  'hulp-vinden': {
    sun: [200, 230, 58],
    hills: [
      'M0 345 C 80 315 160 330 200 350 C 240 330 320 315 400 345 V 500 H 0 Z',
      'M0 410 C 120 385 280 385 400 410 V 500 H 0 Z',
      'M0 460 C 150 445 250 445 400 460 V 500 H 0 Z',
    ],
  },
};
const scene = scenes[slot];
const [cx, cy, r] = scene.sun;
---

<figure class:list={['hero-art-frame', { 'hero-art-frame--photo': photo }]}>
  {
    photo ? (
      <Image
        src={photo.src}
        alt={photo.alt}
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 52rem) 100vw, 40vw"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    ) : (
      <svg viewBox="0 0 400 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="400" height="500" class="art-sky" />
        <circle cx={cx} cy={cy} r={r} class="art-sun" />
        <circle cx={cx} cy={cy} r={r + 26} class="art-halo" />
        {scene.hills.map((d, index) =>
          d.includes(' M') ? (
            <path d={d} class="art-line" />
          ) : (
            <path d={d} class={`art-hill art-hill--${index + 1}`} />
          ),
        )}
      </svg>
    )
  }
</figure>
