---
import CardGrid from './CardGrid.astro';
import PerspectiveSwitch from './PerspectiveSwitch.astro';

interface Props {
  guide: {
    quote: { text: string };
    steps: Array<{ label: string; title: string; quote: string; experience: string }>;
    perspectives: { outside: string; inside: string };
    impacts: Array<{ title: string; text: string }>;
    why: string[];
    reflection: string[];
    nextStep: string[];
  };
}
const { guide } = Astro.props;
---

<section class="section section--soft" aria-labelledby="darvo-steps-heading">
  <div class="wrap">
    <p class="eyebrow">De drie onderdelen</p>
    <h2 id="darvo-steps-heading">Hoe kan het eruitzien?</h2>
    <p class="reading">
      Fictieve zinnen, ter illustratie. Eén zin bewijst niets; het gaat om herhaling en context.
    </p>
    <CardGrid
      items={guide.steps.map((step) => ({
        eyebrow: step.label,
        title: step.title,
        text: `“${step.quote}” — Mogelijke beleving: ${step.experience}`,
        tone: 'tension' as const,
      }))}
    />
  </div>
</section>
<PerspectiveSwitch
  id="darvo-perspectief"
  eyebrow="Twee kanten"
  heading="Wat wordt er gezegd? Wat gebeurt er in jou?"
  intro="De buitenkant en de binnenkant kunnen tegelijk waar zijn. Je gevoel verdient aandacht, ook wanneer niet vaststaat hoe het gedrag van de ander bedoeld was."
  scenarios={[
    {
      label: 'Een gesprek dat verschuift',
      outside: guide.perspectives.outside,
      inside: guide.perspectives.inside,
      context:
        'Niet iedere defensieve reactie is DARVO. Let op of dit steeds terugkomt en of er daarna ruimte is voor wat jij wilde bespreken.',
    },
  ]}
/>
<section class="section section--tension" aria-labelledby="darvo-impact-heading">
  <div class="wrap">
    <p class="eyebrow">De impact</p>
    <h2 id="darvo-impact-heading">Wat kan het met je doen?</h2>
    <p class="reading">
      Bij herhaalde ervaringen kun je jezelf steeds meer gaan controleren. In onderzoek naar DARVO
      werd een verband gevonden met zelfbeschuldiging na een confrontatie; dat zegt niet dat
      iedereen dezelfde gevolgen ervaart.
    </p>
    <CardGrid
      columns={2}
      items={guide.impacts.map((impact) => ({ title: impact.title, text: impact.text }))}
    />
  </div>
</section>
<section class="section section--chrome" aria-labelledby="darvo-why-heading">
  <div class="wrap reading">
    <p class="eyebrow">Waarom het zo kan raken</p>
    <h2 id="darvo-why-heading">Je wilt gehoord worden, niet winnen.</h2>
    {guide.why.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
<section class="section" aria-labelledby="darvo-help-heading" id="een-veilige-volgende-stap">
  <div class="wrap">
    <p class="eyebrow">Wat kan helpen?</p>
    <h2 id="darvo-help-heading">Begin bij wat jij nodig hebt.</h2>
    <div class="grid grid--2">
      <article class="card card--safe">
        <h3>Een veilige reflectie</h3>
        <ol>{guide.reflection.map((item) => <li>{item}</li>)}</ol>
        <p class="note">
          Je hoeft niets in te vullen of te bewaren, zeker niet op een apparaat dat mogelijk
          gecontroleerd wordt.
        </p>
      </article>
      <article class="card">
        <h3>Een volgende stap</h3>
        {guide.nextStep.map((paragraph) => <p>{paragraph}</p>)}
      </article>
    </div>
  </div>
</section>
