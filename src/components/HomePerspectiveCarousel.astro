---
import type { CollectionEntry } from 'astro:content';
import PerspectiveLines from './PerspectiveLines.astro';

/* "Wat je hoort. Wat je voelt.": the Begrijpen chapter of the homepage. One example at a time,
   what is said on the start side and what it does inside on the end side, with arrows to see
   the others. Every example is in the HTML: without JavaScript, and in print, they are listed
   one below the other. */
interface Props {
  scenarios: CollectionEntry<'hubs'>['data']['scenarios'];
  eyebrow: string;
  heading: string;
  lead: string;
  more: { href: string; label: string };
  /* Which example comes first; the hero already opens with the first ones. */
  start?: number;
}
const { scenarios, eyebrow, heading, lead, more, start = 0 } = Astro.props;
const total = scenarios.length;
/* Each example keeps its own anchor (perspectief-scene-N, N as in the content file), so
   articles can link to one; the carousel opens on that example. */
const ordered = scenarios
  .map((scenario, index) => ({ scenario, id: `perspectief-scene-${index}` }))
  .map((_, index, all) => all[(index + start) % total]);
---

<section
  class="section section--chapter chapter--understanding"
  id="perspectief"
  aria-labelledby="perspectief-heading"
>
  <div class="wrap">
    <div class="chapter-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="perspectief-heading">{heading}</h2>
      <p>{lead}</p>
    </div>
    <div
      class="pc"
      data-perspective-carousel
      role="group"
      aria-roledescription="carrousel"
      aria-label="Voorbeeldgesprekken"
    >
      <button class="pc__arrow pc__arrow--prev" type="button" data-pc-prev hidden>
        <span class="sr-only">Vorig voorbeeld</span>
        <span class="pc__chevron pc__chevron--prev" aria-hidden="true"></span>
      </button>
      <ol class="pc__slides">
        {
          ordered.map(({ scenario, id }, index) => (
            <li
              class="pc__slide"
              id={id}
              data-pc-slide
              aria-roledescription="voorbeeld"
              aria-label={`${index + 1} van ${total}: ${scenario.label}`}
            >
              <h3 class="pc__label">{scenario.label}</h3>
              <PerspectiveLines
                outside={scenario.outside}
                inside={scenario.inside}
                outsideLabel="Je hoort"
                insideLabel="Je voelt"
              />
              {scenario.followUp && (
                <p class="pc__follow">
                  <a class="text-link" href={scenario.followUp.href}>
                    {scenario.followUp.label}
                  </a>
                </p>
              )}
            </li>
          ))
        }
      </ol>
      <button class="pc__arrow pc__arrow--next" type="button" data-pc-next hidden>
        <span class="sr-only">Volgend voorbeeld</span>
        <span class="pc__chevron pc__chevron--next" aria-hidden="true"></span>
      </button>
      <div class="pc__controls" data-pc-controls hidden>
        <div class="pc__dots">
          {
            ordered.map(({ scenario }, index) => (
              <button class="pc__dot" type="button" data-pc-dot={index}>
                <span class="sr-only">
                  Voorbeeld {index + 1}: {scenario.label}
                </span>
              </button>
            ))
          }
        </div>
        <p class="pc__count" data-pc-count aria-live="off">1 van {total}</p>
        <button class="pc__pause" type="button" data-pc-pause aria-pressed="false">
          <span class="pc__pause-icon" aria-hidden="true"></span>
          <span class="sr-only" data-pc-pause-label>Pauzeer voorbeelden</span>
        </button>
      </div>
    </div>
    <p class="pc__more"><a class="text-link" href={more.href}>{more.label}</a></p>
  </div>
</section>

<script>
  const motion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-perspective-carousel]')) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-pc-slide]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-pc-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-pc-next]');
    const controls = root.querySelector<HTMLElement>('[data-pc-controls]');
    const count = root.querySelector<HTMLElement>('[data-pc-count]');
    const pause = root.querySelector<HTMLButtonElement>('[data-pc-pause]');
    const pauseLabel = root.querySelector<HTMLElement>('[data-pc-pause-label]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-pc-dot]')];
    if (!prev || !next || !controls || !count || !pause || !pauseLabel || slides.length < 2)
      continue;

    let current = 0;
    let paused = false;
    let visible = false;
    let timer: number | undefined;

    const show = (index: number, direction: number, byUser: boolean) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.toggleAttribute('data-current', active);
        slide.inert = !active;
        slide.setAttribute('aria-hidden', String(!active));
        slide.classList.remove('pc-enter', 'pc-enter--back');
        if (active && direction !== 0 && !motion.matches) {
          void slide.offsetWidth;
          slide.classList.add('pc-enter');
          slide.classList.toggle('pc-enter--back', direction < 0);
        }
      });
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      /* Automatic turns stay silent; a turn the reader asked for is announced. */
      count.setAttribute('aria-live', byUser ? 'polite' : 'off');
      count.textContent = `${current + 1} van ${slides.length}`;
    };

    const busy = () =>
      paused ||
      motion.matches ||
      !visible ||
      document.hidden ||
      root.matches(':hover') ||
      root.contains(document.activeElement);

    const schedule = () => {
      clearInterval(timer);
      pause.hidden = motion.matches;
      pause.setAttribute('aria-pressed', String(paused));
      pauseLabel.textContent = paused ? 'Speel voorbeelden af' : 'Pauzeer voorbeelden';
      root.toggleAttribute('data-paused', paused);
      if (paused || motion.matches) return;
      timer = window.setInterval(() => {
        if (!busy()) show(current + 1, 1, false);
      }, 6000);
    };

    prev.addEventListener('click', () => show(current - 1, -1, true));
    next.addEventListener('click', () => show(current + 1, 1, true));
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => show(i, i >= current ? 1 : -1, true)),
    );
    pause.addEventListener('click', () => {
      paused = !paused;
      schedule();
    });
    motion.addEventListener('change', schedule);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
        },
        { threshold: 0.5 },
      ).observe(root);
    } else {
      visible = true;
    }

    root.dataset.enhanced = '';
    prev.hidden = false;
    next.hidden = false;
    controls.hidden = false;
    const fromHash = () => {
      const target = slides.findIndex((slide) => `#${slide.id}` === location.hash);
      if (target < 0) return false;
      show(target, 0, false);
      return true;
    };
    if (!fromHash()) show(0, 0, false);
    window.addEventListener('hashchange', fromHash);
    schedule();
  }
</script>

<style>
  /* The examples are symmetrical (start side, end side), so the heading sits in the middle
     above them. */
  .chapter-heading {
    max-width: 44rem;
    margin-inline: auto;
    margin-block-end: clamp(1.75rem, 4vw, 3rem);
    text-align: center;
  }

  .chapter-heading .eyebrow {
    color: var(--link);
  }

  .chapter-heading h2 {
    margin-block-end: 0.5rem;
  }

  .chapter-heading p:last-child {
    margin: 0;
    color: var(--muted);
  }

  .pc__slides {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pc__label {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .pc__follow {
    margin: 1rem 0 0;
    text-align: end;
  }

  .pc__more {
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    text-align: center;
  }

  @media screen {
    .pc :global(.pv-lines) {
      display: grid;
      gap: 1rem;
    }

    .pc :global(.pv-line) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
      width: fit-content;
      max-width: min(100%, 34rem);
      margin: 0;
      padding: clamp(1rem, 2.5vw, 1.5rem);
      /* Every block on the homepage has a line; the bubbles too. */
      border: 1px solid var(--chapter-line);
      border-radius: 1.25rem;
      box-sizing: border-box;
    }

    .pc :global(.pv-line dd) {
      font-size: clamp(1.2rem, 1rem + 0.9vw, 1.6rem);
      text-wrap: pretty;
    }

    /* What is said: the start side, aligned to the start. */
    .pc :global(.pv-line--outside) {
      justify-self: start;
      border-end-start-radius: 0.3rem;
      background: var(--surface);
      text-align: start;
    }

    /* What it does inside: the end side, aligned to the end. */
    .pc :global(.pv-line--inside) {
      justify-self: end;
      border-end-end-radius: 0.3rem;
      background: var(--chapter-understanding-bubble);
      text-align: end;
    }

    .pc__arrow,
    .pc__dot,
    .pc__pause {
      display: inline-grid;
      place-items: center;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--text);
      cursor: pointer;
    }

    .pc__arrow[hidden],
    .pc__pause[hidden],
    .pc__controls[hidden] {
      display: none;
    }

    .pc__arrow {
      width: 3rem;
      height: 3rem;
      border: 1.5px solid var(--text);
      border-radius: 50%;
      background: transparent;
    }

    .pc__arrow:hover {
      background: var(--surface);
    }

    .pc__chevron {
      width: 0.6rem;
      height: 0.6rem;
      border-block-start: 2px solid currentColor;
      border-inline-end: 2px solid currentColor;
    }

    .pc__chevron--prev {
      transform: translateX(2px) rotate(-135deg);
    }

    .pc__chevron--next {
      transform: translateX(-2px) rotate(45deg);
    }

    [dir='rtl'] .pc__chevron--prev {
      transform: translateX(-2px) rotate(45deg);
    }

    [dir='rtl'] .pc__chevron--next {
      transform: translateX(2px) rotate(-135deg);
    }

    .pc__controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.25rem 0.75rem;
    }

    .pc__dots {
      display: flex;
    }

    .pc__dot {
      width: 1.75rem;
      height: 2.75rem;
    }

    .pc__dot::before {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background: var(--border-strong);
      content: '';
      transition: width 200ms ease;
    }

    .pc__dot[aria-current='true']::before {
      width: 1.25rem;
      background: var(--link);
    }

    .pc__count {
      margin: 0;
      color: var(--muted);
      font-size: 0.95rem;
      font-variant-numeric: tabular-nums;
    }

    .pc__pause {
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
    }

    .pc__pause-icon {
      width: 0.6rem;
      height: 0.7rem;
      border-inline: 0.18rem solid currentColor;
    }

    .pc[data-paused] .pc__pause-icon {
      border: 0;
      background: currentColor;
      clip-path: polygon(0 0, 100% 50%, 0 100%);
    }

    .pc :is(.pc__arrow, .pc__dot, .pc__pause):focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 2px;
    }

    /* Enhanced: one example at a time. All examples share one grid cell, so the longest one
       sets the height and nothing below jumps when the example changes. */
    .pc[data-enhanced] {
      display: grid;
      grid-template-columns: 3rem minmax(0, 1fr) 3rem;
      grid-template-areas:
        'stage stage stage'
        'prev controls next';
      align-items: center;
      gap: 1rem 0.5rem;
    }

    .pc[data-enhanced] .pc__slides {
      grid-area: stage;
      grid-template-areas: 'slide';
    }

    /* The pair of bubbles keeps its own height and sits in the middle of the room the
       longest example needs. */
    .pc[data-enhanced] .pc__slide {
      grid-area: slide;
      align-self: center;
    }

    .pc[data-enhanced] .pc__slide:not([data-current]) {
      visibility: hidden;
    }

    .pc[data-enhanced] .pc__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .pc__arrow--prev {
      grid-area: prev;
    }

    .pc__arrow--next {
      grid-area: next;
    }

    .pc__controls {
      grid-area: controls;
    }
  }

  @media screen and (min-width: 52rem) {
    .pc :global(.pv-lines) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .pc :global(.pv-line) {
      max-width: 100%;
    }

    /* The feeling comes a beat later: lower, like an answer. */
    .pc :global(.pv-line--inside) {
      margin-block-start: 3.5rem;
    }

    /* Wide screens: arrows join the dots and pause in one calm row below, as in the hero. */
    .pc[data-enhanced] {
      grid-template-columns: minmax(0, 1fr) auto auto auto minmax(0, 1fr);
      grid-template-areas:
        'stage stage stage stage stage'
        '. prev controls next .';
      gap: 1.5rem 0.5rem;
    }

    .pc__arrow {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .pc-enter {
      animation: pc-from-end 420ms ease-out both;
    }

    .pc-enter--back {
      animation-name: pc-from-start;
    }

    .pc-enter :global(.pv-line--outside) {
      animation: pc-shake 380ms ease-in-out 140ms;
    }

    .pc-enter :global(.pv-line--inside),
    .pc-enter .pc__follow {
      animation: pc-in 300ms ease-out 440ms both;
    }
  }

  /* Like a chat: the next example comes in from above, going back it comes from below. */
  @keyframes pc-from-end {
    from {
      opacity: 0;
      transform: translateY(-2rem);
    }
  }

  @keyframes pc-from-start {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
  }

  @keyframes pc-shake {
    18% {
      transform: rotate(-2.5deg);
    }
    36% {
      transform: rotate(2deg);
    }
    54% {
      transform: rotate(-1.4deg);
    }
    72% {
      transform: rotate(0.8deg);
    }
  }

  @keyframes pc-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
  }

  @media print {
    .pc__arrow,
    .pc__controls {
      display: none !important;
    }

    .pc__slide {
      visibility: visible !important;
      break-inside: avoid;
    }

    .pc__label {
      position: static !important;
      width: auto !important;
      height: auto !important;
      clip: auto !important;
    }
  }
</style>
