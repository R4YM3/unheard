---
/**
 * A quiet byline at the end of an article: who wrote it and when it was last updated. These
 * are the dates and author that the Article structured data repeats.
 */
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { founderName } from '../lib/site';

interface Props {
  author: 'founder' | 'editorial';
  publishedAt: Date;
  updatedAt: Date;
  locale: Locale;
}
const { author, publishedAt, updatedAt, locale } = Astro.props;
const t = ui(locale);
const format = (date: Date) =>
  new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
const iso = (date: Date) => date.toISOString().slice(0, 10);
const byline = author === 'founder' ? (founderName ?? t.byFounder) : t.byEditorial;
---

<p class="wrap reading article-byline">
  {`${t.writtenBy} ${byline} · ${t.publishedOn} `}<time datetime={iso(publishedAt)}
    >{format(publishedAt)}</time
  >{
    iso(updatedAt) !== iso(publishedAt) && (
      <>
        {` · ${t.updatedOn} `}
        <time datetime={iso(updatedAt)}>{format(updatedAt)}</time>
      </>
    )
  }
</p>
