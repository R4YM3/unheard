---
import type { RoutedEntry } from '../lib/content';

interface Props {
  entry: RoutedEntry;
}
const { data } = Astro.props.entry;
---

{
  data.status !== 'approved' && (
    <div class="wrap">
      <p class="draft-notice">
        Deze pagina is een conceptversie en is nog niet inhoudelijk gecontroleerd. Lees haar als
        oriëntatie, niet als advies.
      </p>
    </div>
  )
}
