---
/**
 * A quiet line at the end of an article: when it was published and last updated (the dates
 * the Article structured data repeats). Optionally a note on what the page rests on.
 */
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  publishedAt: Date;
  updatedAt: Date;
  locale: Locale;
  note?: string;
}
const { publishedAt, updatedAt, locale, note } = Astro.props;
const t = ui(locale);
const format = (date: Date) =>
  new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
const iso = (date: Date) => date.toISOString().slice(0, 10);
const published = t.publishedOn.charAt(0).toUpperCase() + t.publishedOn.slice(1);
---

<div class="wrap reading article-byline">
  <p>
    {`${published} `}<time datetime={iso(publishedAt)}>{format(publishedAt)}</time>{
      iso(updatedAt) !== iso(publishedAt) && (
        <>
          {` · ${t.updatedOn} `}
          <time datetime={iso(updatedAt)}>{format(updatedAt)}</time>
        </>
      )
    }
  </p>
  {
    note && (
      <p class="note" data-source-note>
        {note}
      </p>
    )
  }
</div>
