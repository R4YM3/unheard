---
/**
 * The pages between the section and the current page, then the current page itself (not a
 * link), so readers always see where they are. Home is the logo.
 */
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import type { Crumb } from '../lib/trail';

interface Props {
  ancestors: Crumb[];
  current?: Crumb;
  locale: Locale;
}
const { ancestors, current, locale } = Astro.props;
---

{
  ancestors.length > 0 && (
    <nav class="breadcrumbs" aria-label={ui(locale).breadcrumb}>
      <ol>
        {ancestors.map((crumb) => (
          <li>
            <a href={crumb.href}>{crumb.label}</a>
          </li>
        ))}
        {current && (
          <li class="breadcrumbs__current" aria-current="page">
            {current.label}
          </li>
        )}
      </ol>
    </nav>
  )
}
