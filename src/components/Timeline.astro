---
import Marked from './Marked.astro';
import { REVIEW_MARKER } from '../lib/review-marks';
/** Layered personal timeline: main milestones always visible, layers and in-between moments expandable (and fully printed). */
interface Milestone {
  eyebrow: string;
  title: string;
  description: string;
  lenses: Array<{ heading: string; text: string }>;
  between: Array<{ title: string; text: string }>;
}
interface Props {
  label: string;
  milestones: Milestone[];
}
const { label, milestones } = Astro.props;
---

<ol class="timeline" aria-label={label}>
  {
    milestones.map((milestone) => (
      <li>
        <article class="card">
          <p class="eyebrow">{milestone.eyebrow}</p>
          <h3>{milestone.title}</h3>
          <p>{milestone.description}</p>
          {milestone.lenses.length > 0 && (
            <details
              class:list={{
                'needs-review': milestone.lenses.every((lens) => lens.text.includes(REVIEW_MARKER)),
              }}
            >
              <summary>Lees de vier lagen van dit moment</summary>
              <div class="timeline-lenses">
                {milestone.lenses.map((lens) => (
                  <section class="timeline-lens">
                    <h4>{lens.heading}</h4>
                    <p>
                      <Marked text={lens.text} />
                    </p>
                  </section>
                ))}
              </div>
            </details>
          )}
          {milestone.between.length > 0 && (
            <div class="timeline-between">
              {milestone.between.map((moment) => (
                <details>
                  <summary>{moment.title}</summary>
                  <p>
                    <Marked text={moment.text} />
                  </p>
                </details>
              ))}
            </div>
          )}
        </article>
      </li>
    ))
  }
</ol>
