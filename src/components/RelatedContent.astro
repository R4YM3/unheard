---
import { localeFromPath } from '../i18n/config';
import { ui } from '../i18n/ui';
import type { LinkCard } from '../lib/content';
import CardGrid from './CardGrid.astro';

type RelatedItem = Pick<LinkCard, 'href' | 'title' | 'text'> &
  Partial<Pick<LinkCard, 'eyebrow' | 'collection'>>;
interface Props {
  items: RelatedItem[];
  heading?: string;
  /** The band colour (a CSS colour or var); the pillar's colour on its pages. */
  band?: string;
  /** The pillar whose pattern the band carries (pillar-band--…). */
  pillar?: string;
}
const t = ui(localeFromPath(Astro.url.pathname, import.meta.env.BASE_URL));
const { items, heading = t.readMore, band, pillar } = Astro.props;
---

{
  items.length > 0 && (
    <section
      class:list={[
        'section section--tint related-band',
        pillar && `pillar-band pillar-band--${pillar}`,
      ]}
      style={band ? `--section-bg: ${band}` : undefined}
      aria-labelledby="related-heading"
      id="gerelateerd"
    >
      <div class="wrap">
        <h2 id="related-heading">{heading}</h2>
        <div class="related-scroller">
          <CardGrid
            items={items.map((item) => ({
              eyebrow: item.eyebrow,
              title: item.title,
              text: item.text,
              href: item.href,
              tone: item.collection === 'patterns' ? ('tension' as const) : ('neutral' as const),
            }))}
          />
        </div>
      </div>
    </section>
  )
}
