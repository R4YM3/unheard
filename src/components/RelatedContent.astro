---
import type { LinkCard } from '../lib/content';
import CardGrid from './CardGrid.astro';

interface Props {
  items: LinkCard[];
  heading?: string;
}
const { items, heading = 'Verder lezen' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section section--soft" aria-labelledby="related-heading" id="gerelateerd">
      <div class="wrap">
        <p class="eyebrow">Gerelateerd</p>
        <h2 id="related-heading">{heading}</h2>
        <CardGrid
          items={items.map((item) => ({
            eyebrow: item.eyebrow,
            title: item.title,
            text: item.text,
            href: item.href,
            tone: item.collection === 'patterns' ? ('tension' as const) : ('neutral' as const),
          }))}
        />
      </div>
    </section>
  )
}
