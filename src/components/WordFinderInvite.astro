---
interface Props {
  heading: string;
  text: string;
  note: string;
  href: string;
  label: string;
}
/* The note about skipping questions and nothing being stored belongs on the word finder
   itself, not on every page that points to it. */
const { heading, text, href, label } = Astro.props;
---

<section
  class="section section--soft"
  aria-labelledby="word-finder-invite-heading"
  id="woorden-vinden"
>
  <div class="wrap word-finder-invite">
    <div>
      <h2 id="word-finder-invite-heading">{heading}</h2>
      <p class="word-finder-intro">{text}</p>
    </div>
    <a class="button" href={href}>{label}<span aria-hidden="true"> →</span></a>
  </div>
</section>
<style>
  .word-finder-invite {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
  }
  .button {
    gap: 0.5rem;
  }
  h2 {
    font-size: clamp(1.75rem, 3vw, 2.65rem);
    max-width: 24ch;
  }
  p {
    max-width: 65ch;
  }
  .word-finder-intro {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    max-width: 48ch;
  }
  .note {
    margin-block-end: 0;
  }
  @media (max-width: 48rem) {
    .word-finder-invite {
      grid-template-columns: 1fr;
    }
    .button {
      justify-self: start;
    }
  }
</style>
