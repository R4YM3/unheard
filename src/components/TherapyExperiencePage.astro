---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import SourceList from './SourceList.astro';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { data } = entry;
if (data.kind !== 'therapy' || !data.therapy) {
  throw new Error(`TherapyExperiencePage requires a therapy page entry; received ${entry.id}.`);
}
const therapy = data.therapy;
---

<section class="hero hero--story-page">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{data.eyebrow}</p>
      <h1>{data.heading}</h1>
      <p class="lead">{data.lead}</p>
      <a class="button" href="#ervaringen">Ontdek mijn ervaringen</a>
    </div>
    <div class="story-hero-visual" aria-hidden="true"></div>
  </div>
</section>
<section class="section">
  <div class="wrap reading">
    <p class="eyebrow">{therapy.introduction.eyebrow}</p>
    <h2>{therapy.introduction.heading}</h2>
    {therapy.introduction.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <blockquote class="quote">{therapy.introduction.quote}</blockquote>
    <aside class="help">{therapy.introduction.notice}</aside>
  </div>
</section>
<section class="section section--soft" id="ervaringen">
  <div class="wrap">
    <p class="eyebrow">{therapy.experiences.eyebrow}</p>
    <h2>{therapy.experiences.heading}</h2>
    <p class="reading">{therapy.experiences.lead}</p>
    <div class="grid therapy-grid">
      {
        therapy.experiences.items.map((item) => (
          <Card>
            <p class="eyebrow">{item.eyebrow}</p>
            <h3>{item.title}</h3>
            <p>{item.personal}</p>
            <details>
              <summary>Wat houdt het in?</summary>
              <p>{item.explanation}</p>
              <p class="note">
                Algemene uitleg; geen persoonlijk behandeladvies. Bespreek keuzes met een
                gekwalificeerde professional.
              </p>
            </details>
          </Card>
        ))
      }
    </div>
  </div>
</section>
<section class="section">
  <div class="wrap">
    <p class="eyebrow">{therapy.questions.eyebrow}</p>
    <h2>{therapy.questions.heading}</h2>
    <p class="reading">{therapy.questions.lead}</p>
    <div class="grid question-grid">
      {
        therapy.questions.items.map((item) => (
          <Card href="#ervaringen">
            <>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </>
          </Card>
        ))
      }
    </div>
  </div>
</section>
<section class="section closing-section">
  <div class="wrap reading">
    <p class="eyebrow">{therapy.closing.eyebrow}</p>
    <h2>{therapy.closing.heading}</h2>
    {therapy.closing.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="quote">{therapy.closing.quote}</p>
  </div>
</section>
<section class="section section--soft">
  <div class="wrap reading">
    <p class="eyebrow">{therapy.support.eyebrow}</p>
    <h2>{therapy.support.heading}</h2>
    {therapy.support.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <a class="button" href={therapy.support.href}>{therapy.support.label}</a>
  </div>
</section>
<SourceList sources={data.sources} />
