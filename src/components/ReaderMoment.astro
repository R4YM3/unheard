---
/** A short, fictional inner thought that gives the article's feeling a visible place. */
interface Props {
  moment: { label: string; thought: string; feeling: string };
}
const { moment } = Astro.props;
---

<section class="reader-moment" aria-labelledby="reader-moment-heading">
  <div class="wrap reading">
    <p class="reader-moment__label">{moment.label}</p>
    <h2 id="reader-moment-heading" class="sr-only">{moment.label}</h2>
    <blockquote class="reader-moment__thought">
      <p>“{moment.thought}”</p>
    </blockquote>
    <p class="reader-moment__feeling">{moment.feeling}</p>
  </div>
</section>
