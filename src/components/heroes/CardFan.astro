---
/* Hulpmiddelen: the six question cards as a fan, like printed cards in your hand. Two parts,
   as on the design canvas: the fan on the visual side (`part="fan"`) and the card's first
   step under the lead (`part="preview"`). Each card links to its page; pointing at or
   focusing one lifts it and shows its first step (from the card's own instructions). The
   steps share one grid cell, so the hero never changes height. Without JavaScript the cards
   are plain links. */
import { fanCards } from '../../data/pillar-heroes';
import { findByKey, routeFor } from '../../lib/content';

interface Props {
  locale: string;
  part: 'fan' | 'preview';
}
const { locale, part } = Astro.props;
const cards = await Promise.all(
  fanCards.map(async (key) => {
    const entry = await findByKey(locale, key);
    if (!entry || entry.collection !== 'tools')
      throw new Error(`CardFan: unknown or unpublished tool "${key}"`);
    return { title: entry.data.card.title, step: entry.data.usage[0], href: routeFor(entry) };
  }),
);
const middle = (cards.length - 1) / 2;
---

{
  part === 'fan' ? (
    <>
      <ul class="cf__fan" data-cf-fan>
        {cards.map((card, i) => (
          <li style={`--turn: ${(i - middle) * 7}deg; --step: ${i - middle}; --i: ${i}`}>
            <a class="cf__card" href={card.href} data-cf-index={i}>
              <span class="cf__number">Kaart {i + 1}</span>
              <span class="cf__title">{card.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="cf__swipe" aria-hidden="true">
        Veeg voor meer kaarten <span>→</span>
      </p>
    </>
  ) : (
    <div class="cf__preview" data-cf-preview>
      <p class="cf__hint" data-current>
        Wijs een kaart aan om de eerste stap te lezen.
      </p>
      {cards.map((card) => (
        <div class="cf__step">
          <p class="cf__step-title">{card.title}</p>
          <p>
            <strong>Eerste stap:</strong> {card.step}
          </p>
          <p class="cf__open">
            <a class="text-link" href={card.href}>
              Open deze kaart
            </a>
          </p>
        </div>
      ))}
    </div>
  )
}

<script>
  import { previewOnFirstTap } from '../../lib/tap-preview';

  const preview = document.querySelector<HTMLElement>('[data-cf-preview]');
  const items = preview ? [...preview.children] : [];
  for (const card of document.querySelectorAll<HTMLElement>('[data-cf-fan] .cf__card')) {
    const index = Number(card.dataset.cfIndex) + 1;
    const show = () => {
      items.forEach((item, i) => item.toggleAttribute('data-current', i === index));
      for (const other of document.querySelectorAll('[data-cf-fan] .cf__card'))
        other.toggleAttribute('data-current', other === card);
    };
    card.addEventListener('pointerenter', (event) => event.pointerType === 'mouse' && show());
    card.addEventListener('focus', show);
    previewOnFirstTap(card, show, () => card.hasAttribute('data-current'));
  }
  /* Start with the first card chosen. */
  document.querySelector<HTMLElement>('[data-cf-fan] .cf__card')?.dispatchEvent(new Event('focus'));
</script>

<style>
  .cf__fan {
    position: relative;
    height: 20rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cf__fan li {
    position: absolute;
    --spread: clamp(2.25rem, 4.5vw, 4.25rem);
    left: calc(50% - 6.5rem + var(--step) * var(--spread));
    top: 1.5rem;
    z-index: var(--i);
    transform: rotate(var(--turn));
    transform-origin: 50% 130%;
    transition: transform 0.28s ease;
  }

  [dir='rtl'] .cf__fan li {
    left: auto;
    right: calc(50% - 6.5rem + var(--step) * var(--spread));
  }

  .cf__fan li:has(.cf__card:is(:hover, :focus-visible)) {
    z-index: 10;
    transform: rotate(0deg) translateY(-1.25rem);
  }

  /* Chosen but not pointed at: lifted a little in its place, so it hides no other card. */
  .cf__fan li:has(.cf__card[data-current]):not(:has(.cf__card:is(:hover, :focus-visible))) {
    transform: rotate(var(--turn)) translateY(-0.75rem);
  }

  /* The chosen card: dark, so it reads as chosen on every screen. */
  .cf__card[data-current] {
    border-color: var(--text);
    background: var(--text);
    color: var(--surface);
  }

  .cf__card[data-current] .cf__number {
    color: inherit;
    opacity: 0.8;
  }

  .cf__card {
    display: flex;
    width: 13rem;
    height: 17rem;
    box-sizing: border-box;
    flex-direction: column;
    padding: 1.25rem;
    border: 1px solid var(--chapter-tools-line);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: 0 0.25rem 0.75rem color-mix(in srgb, var(--text) 8%, transparent);
    color: var(--text);
    text-decoration: none;
  }

  .cf__card:is(:hover, :focus-visible) {
    box-shadow: 0 0.9rem 1.75rem color-mix(in srgb, var(--text) 16%, transparent);
  }

  .cf__card:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .cf__number {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cf__title {
    margin-block-start: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  /* Hint and steps share one cell: the longest sets the height. */
  .cf__preview {
    display: grid;
  }

  .cf__preview > * {
    grid-area: 1 / 1;
    align-self: start;
    margin: 0;
  }

  .cf__preview > :not([data-current]) {
    visibility: hidden;
  }

  .cf__preview p {
    margin: 0;
  }

  .cf__hint {
    padding-inline-start: 0.875rem;
    border-inline-start: 3px solid var(--text);
    color: var(--hero-muted);
  }

  .cf__step {
    color: var(--hero-muted);
    line-height: 1.5;
  }

  .cf__open {
    margin-block-start: 0.4rem !important;
  }

  .cf__step-title {
    margin-block-end: 0.25rem !important;
    color: var(--text);
    font-weight: 700;
  }

  .cf__swipe {
    display: none;
  }

  /* A phone: no fan, the cards in a row you can swipe through. The row runs to the edge of
     the screen so the next card peeks in, with a fade at the edge and a hint below. */
  @media (max-width: 42rem) {
    .cf__fan {
      display: flex;
      height: auto;
      gap: 0.75rem;
      margin-inline: -1.125rem;
      overflow-x: auto;
      padding: 0.75rem 3rem 0.75rem 1.125rem;
      scroll-padding-inline: 1.125rem;
      scroll-snap-type: x mandatory;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 3rem), transparent);
    }

    .cf__swipe {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin: 0.25rem 0 0;
      color: var(--hero-muted);
      font-size: 0.9rem;
    }

    .cf__fan li,
    [dir='rtl'] .cf__fan li {
      position: static;
      flex: 0 0 auto;
      transform: none;
      scroll-snap-align: start;
    }

    .cf__fan li:has(.cf__card:is(:hover, :focus-visible)) {
      transform: none;
    }

    .cf__card {
      width: 9.75rem;
      height: 11.5rem;
    }

    .cf__fan li:has(.cf__card[data-current]) {
      transform: translateY(-0.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cf__fan li {
      transition: none;
    }
  }

  @media print {
    .cf__fan,
    .cf__preview {
      display: none;
    }
  }
</style>
