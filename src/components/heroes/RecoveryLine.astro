---
/* Herstel: a line that is not straight. Five topics along it, each with a sentence from its
   own article (the build checks that the sentence is in it). Two parts, as on the design
   canvas: the quote card on the visual side (`part="quote"`) and the line edge to edge along
   the bottom of the hero (`part="line"`). Picking a point draws the line up to it, with a
   ripple where it lands. The quotes share one grid cell, so the card never changes height.
   Without JavaScript the five sentences are listed and the line is not shown. */
import { recoverySteps } from '../../data/pillar-heroes';
import { cardFor, findByKey } from '../../lib/content';

interface Props {
  locale: string;
  part: 'quote' | 'line';
}
const { locale, part } = Astro.props;
const steps = await Promise.all(
  recoverySteps.map(async (step) => {
    const entry = await findByKey(locale, step.key);
    if (!entry) throw new Error(`RecoveryLine: unknown or unpublished key "${step.key}"`);
    const text = `${entry.data.summary ?? ''} ${entry.body ?? ''}`.replace(/\s+/g, ' ');
    if (!text.includes(step.quote))
      throw new Error(`RecoveryLine: the sentence for "${step.key}" is not in that article`);
    return { ...step, href: cardFor(entry).href, title: entry.data.title };
  }),
);
/* The line across a 1440 × 240 box: up, down, back and up again. Drawn left to right in
   every language: it is a picture of time, not text. */
const points: Array<[number, number]> = [
  [-20, 200],
  [260, 110],
  [470, 175],
  [740, 80],
  [960, 150],
  [1230, 55],
];
const segments = points.slice(1).map(([x, y], i) => {
  const [ax, ay] = points[i];
  const mx = (ax + x) / 2;
  return `M${ax} ${ay} C ${mx} ${ay}, ${mx} ${y}, ${x} ${y}`;
});
---

{
  part === 'quote' ? (
    <ol class="rl-quotes" data-rl-quotes>
      {steps.map((step, index) => (
        <li class="rl-quote" data-current={index === 0 ? '' : undefined}>
          <figure class="hero-quote-card">
            <p class="hero-quote-card__label">{step.name}</p>
            <blockquote>
              <p>“{step.quote}”</p>
            </blockquote>
            <figcaption>
              Uit{' '}
              <a class="text-link" href={step.href}>
                {step.title}
              </a>
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>
  ) : (
    <div class="rl-line" dir="ltr" data-rl-line hidden>
      <svg viewBox="0 0 1440 240" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="rl-line__ghost" d={`M${points.map((p) => p.join(' ')).join(' L')}`} />
        {segments.map((d) => (
          <path class="rl-line__segment" d={d} pathLength="1" data-rl-segment />
        ))}
      </svg>
      <span class="rl-line__ripple" aria-hidden="true" data-rl-ripple />
      {steps.map((step, index) => (
        <button
          type="button"
          class="rl-line__point"
          style={`--x: ${(points[index + 1][0] / 1440) * 100}%; --y: ${(points[index + 1][1] / 240) * 100}%`}
          aria-pressed={index === 0 ? 'true' : 'false'}
          data-rl-point
        >
          <span class="rl-line__dot" aria-hidden="true" />
          <span class="rl-line__name">{step.name}</span>
        </button>
      ))}
    </div>
  )
}

<script>
  const quotes = [...document.querySelectorAll<HTMLElement>('[data-rl-quotes] > li')];
  const line = document.querySelector<HTMLElement>('[data-rl-line]');
  const segments = [...document.querySelectorAll<SVGPathElement>('[data-rl-segment]')];
  const points = [...document.querySelectorAll<HTMLButtonElement>('[data-rl-point]')];
  const ripple = document.querySelector<HTMLElement>('[data-rl-ripple]');
  if (line && ripple && quotes.length > 0 && quotes.length === points.length) {
    const show = (index: number) => {
      quotes.forEach((quote, i) => quote.toggleAttribute('data-current', i === index));
      segments.forEach((segment, i) => segment.classList.toggle('is-drawn', i <= index));
      points.forEach((point, i) => {
        point.classList.toggle('is-reached', i <= index);
        point.setAttribute('aria-pressed', String(i === index));
      });
      ripple.style.setProperty('--x', points[index].style.getPropertyValue('--x'));
      ripple.style.setProperty('--y', points[index].style.getPropertyValue('--y'));
    };
    points.forEach((point, i) => point.addEventListener('click', () => show(i)));
    document.querySelector('[data-rl-quotes]')?.setAttribute('data-enhanced', '');
    line.hidden = false;
    show(0);
  }
</script>

<style>
  .rl-quotes {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Enhanced: the five quotes in one cell, only the current one visible. */
  .rl-quotes[data-enhanced] > li {
    grid-area: 1 / 1;
  }

  .rl-quotes[data-enhanced] > li:not([data-current]) {
    visibility: hidden;
  }

  .rl-quotes[data-enhanced] .hero-quote-card {
    height: 100%;
    box-sizing: border-box;
  }

  .rl-line {
    position: absolute;
    inset: 0;
  }

  .rl-line[hidden] {
    display: none;
  }

  .rl-line svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .rl-line svg path {
    fill: none;
    stroke: var(--hero-eyebrow);
    stroke-linecap: round;
  }

  .rl-line__ghost {
    stroke-dasharray: 3 7;
    stroke-opacity: 0.25;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .rl-line__segment {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-width: 3;
    transition: stroke-dashoffset 0.7s ease;
  }

  .rl-line__segment.is-drawn {
    stroke-dashoffset: 0;
  }

  .rl-line__ripple {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 5rem;
    height: 5rem;
    border: 1.5px solid var(--hero-eyebrow);
    border-radius: 50%;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(0.2);
    animation: rl-ripple 1.8s ease-out infinite;
  }

  @keyframes rl-ripple {
    from {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(0.2);
    }
    to {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  .rl-line__point {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transform: translate(-50%, -50%);
  }

  .rl-line__dot {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--hero-eyebrow);
    border-radius: 50%;
    background: var(--chapter-bg, var(--hero-bg));
    transition: transform 0.2s ease;
  }

  .rl-line__point.is-reached .rl-line__dot {
    background: var(--hero-eyebrow);
  }

  .rl-line__point[aria-pressed='true'] .rl-line__dot {
    transform: scale(1.4);
  }

  .rl-line__name {
    position: absolute;
    bottom: 100%;
    left: 50%;
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
    transform: translateX(-50%);
    opacity: 0.65;
  }

  .rl-line__point.is-reached .rl-line__name {
    opacity: 1;
  }

  .rl-line__point:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: 50%;
  }

  /* A phone: only the current point is named, so the names never collide. */
  @media (max-width: 42rem) {
    .rl-line__point:not([aria-pressed='true']) .rl-line__name {
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rl-line__segment,
    .rl-line__dot {
      transition: none;
    }

    .rl-line__ripple {
      animation: none;
      opacity: 0.3;
      transform: translate(-50%, -50%) scale(0.45);
    }
  }

  @media print {
    .rl-quotes > li {
      visibility: visible !important;
      grid-area: auto !important;
    }

    .rl-line {
      display: none !important;
    }
  }
</style>
