---
/* Mijn verhaal: the ridge of the pattern is the timeline. Two parts, as on the design canvas:
   the quote card on the visual side (`part="quote"`) and the ridge edge to edge along the
   bottom of the hero (`part="ridge"`). Each point is one of the founder's milestones, with
   its own title, and links to that moment in the timeline below. Pointing at or focusing a
   point shows its title in the card. All titles share one grid cell, so the card never
   changes height. */
interface Props {
  milestones: Array<{ title: string }>;
  part: 'quote' | 'ridge';
  /** The timeline page the points link to. */
  timelineHref: string;
}
const { milestones, part, timelineHref } = Astro.props;
const width = 1440;
const ridgeY = (x: number) => 118 + 44 * Math.sin(x / 230 + 0.6) + 18 * Math.sin(x / 96 - 1.2);
const line = (fn: (x: number) => number) =>
  'M' +
  Array.from({ length: 73 }, (_, i) => {
    const x = (i / 72) * width;
    return `${x.toFixed(1)} ${fn(x).toFixed(1)}`;
  }).join(' L');
const back = [0, 1, 2, 3].map((k) =>
  line((x) => 160 + k * 20 + (22 - k * 4) * Math.sin(x / (150 - k * 12) + k * 1.1)),
);
const dots = milestones.map((milestone, i) => {
  const x = 110 + (i * (width - 220)) / Math.max(1, milestones.length - 1);
  return { ...milestone, x, y: ridgeY(x), href: `${timelineHref}#moment-${i + 1}` };
});
---

{
  part === 'quote' ? (
    <figure class="hero-quote-card sr-card" data-sr-card>
      <div class="sr-card__titles">
        {milestones.map((milestone, i) => (
          <div class="sr-card__title" data-current={i === 0 ? '' : undefined}>
            <p class="hero-quote-card__label">
              Moment {i + 1} van {milestones.length}
            </p>
            <blockquote>
              <p>“{milestone.title}”</p>
            </blockquote>
          </div>
        ))}
      </div>
      <figcaption>
        Uit{' '}
        <a class="text-link" href={timelineHref} data-sr-link>
          de tijdlijn in Mijn verhaal
        </a>
      </figcaption>
    </figure>
  ) : (
    <div class="sr-ridge" dir="ltr" data-sr-ridge>
      <svg
        viewBox={`0 0 ${width} 240`}
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        {back.map((d) => (
          <path class="sr-ridge__back" d={d} />
        ))}
        <path class="sr-ridge__ridge" d={line(ridgeY)} />
      </svg>
      <ol class="sr-ridge__dots">
        {dots.map((dot, i) => (
          <li style={`--x: ${(dot.x / width) * 100}%; --y: ${(dot.y / 240) * 100}%`}>
            <a
              class="sr-ridge__dot"
              href={dot.href}
              data-sr-dot
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="sr-only">
                Moment {i + 1}: {dot.title}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  )
}

<script>
  import { previewOnFirstTap } from '../../lib/tap-preview';

  const titles = [...document.querySelectorAll<HTMLElement>('[data-sr-card] .sr-card__title')];
  const link = document.querySelector<HTMLAnchorElement>('[data-sr-link]');
  const dots = [...document.querySelectorAll<HTMLAnchorElement>('[data-sr-dot]')];
  if (link && titles.length === dots.length) {
    const show = (index: number) => {
      titles.forEach((title, i) => title.toggleAttribute('data-current', i === index));
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      link.href = dots[index].href;
    };
    dots.forEach((dot, i) => {
      dot.addEventListener('pointerenter', (event) => event.pointerType === 'mouse' && show(i));
      dot.addEventListener('focus', () => show(i));
      previewOnFirstTap(
        dot,
        () => show(i),
        () => dot.getAttribute('aria-current') === 'true',
      );
    });
  }
</script>

<style>
  /* The titles share one cell: the longest sets the height. */
  .sr-card__titles {
    display: grid;
  }

  .sr-card__title {
    grid-area: 1 / 1;
  }

  .sr-card__title:not([data-current]) {
    visibility: hidden;
  }

  .sr-ridge {
    position: absolute;
    inset: 0;
  }

  .sr-ridge svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sr-ridge svg path {
    fill: none;
    stroke: var(--text);
    vector-effect: non-scaling-stroke;
  }

  .sr-ridge__back {
    stroke-opacity: 0.14;
    stroke-width: 1.2;
  }

  .sr-ridge__ridge {
    stroke-opacity: 0.55;
    stroke-width: 2;
  }

  .sr-ridge__dots {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sr-ridge__dots li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
  }

  .sr-ridge__dot {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
  }

  .sr-ridge__dot::before {
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--text);
    border-radius: 50%;
    background: var(--chapter-bg, var(--hero-bg));
    content: '';
    transition: transform 0.2s ease;
  }

  .sr-ridge__dot[aria-current='true']::before {
    border-color: var(--link);
    background: var(--link);
    transform: scale(1.5);
  }

  .sr-ridge__dot:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .sr-ridge__dot::before {
      transition: none;
    }
  }

  @media print {
    .sr-card__title {
      visibility: visible !important;
      grid-area: auto;
    }

    .sr-ridge {
      display: none;
    }
  }
</style>
