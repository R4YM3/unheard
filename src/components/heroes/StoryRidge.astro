---
/* Mijn verhaal: the ridge of the pattern is the timeline. Each point is one of the founder's
   milestones, with its own title, and links to that moment in the timeline below. Pointing
   at or focusing a point shows its title in the quote card. */
interface Props {
  milestones: Array<{ title: string }>;
}
const { milestones } = Astro.props;
const ridgeY = (x: number) => 95 + 38 * Math.sin(x / 120 + 0.6) + 16 * Math.sin(x / 52 - 1.2);
const width = 600;
const ridge = Array.from({ length: 61 }, (_, i) => {
  const x = (i / 60) * width;
  return `${x.toFixed(1)} ${ridgeY(x).toFixed(1)}`;
});
const back = [0, 1, 2].map((k) =>
  Array.from({ length: 61 }, (_, i) => {
    const x = (i / 60) * width;
    const y = 135 + k * 20 + (14 - k * 3) * Math.sin(x / (90 - k * 8) + k * 1.1);
    return `${x.toFixed(1)} ${y.toFixed(1)}`;
  }),
);
const dots = milestones.map((milestone, i) => {
  const x = 30 + (i * (width - 60)) / Math.max(1, milestones.length - 1);
  return { ...milestone, x, y: ridgeY(x), href: `#moment-${i + 1}` };
});
---

<div class="sr-ridge" data-story-ridge>
  <figure class="hero-quote-card sr-ridge__card">
    <p class="sr-ridge__count" data-sr-count>Moment 1 van {milestones.length}</p>
    <blockquote>
      <p data-sr-title>“{milestones[0]?.title}”</p>
    </blockquote>
    <figcaption>
      Uit <a class="text-link" href="#tijdlijn" data-sr-link>de tijdlijn in Mijn verhaal</a>
    </figcaption>
  </figure>
  <div class="sr-ridge__line">
    <svg
      viewBox={`0 0 ${width} 200`}
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
    >
      {back.map((line) => <path class="sr-ridge__back" d={`M${line.join(' L')}`} fill="none" />)}
      <path class="sr-ridge__ridge" d={`M${ridge.join(' L')}`} fill="none"></path>
    </svg>
    <ol class="sr-ridge__dots">
      {
        dots.map((dot, i) => (
          <li style={`--x: ${(dot.x / width) * 100}%; --y: ${(dot.y / 200) * 100}%`}>
            <a
              class="sr-ridge__dot"
              href={dot.href}
              data-sr-dot
              data-title={dot.title}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="sr-only">
                Moment {i + 1}: {dot.title}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-story-ridge]')) {
    const count = root.querySelector<HTMLElement>('[data-sr-count]');
    const title = root.querySelector<HTMLElement>('[data-sr-title]');
    const link = root.querySelector<HTMLAnchorElement>('[data-sr-link]');
    const dots = [...root.querySelectorAll<HTMLAnchorElement>('[data-sr-dot]')];
    if (!count || !title || !link) continue;
    const show = (index: number) => {
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      count.textContent = `Moment ${index + 1} van ${dots.length}`;
      title.textContent = `“${dots[index].dataset.title}”`;
      link.href = dots[index].href;
    };
    dots.forEach((dot, i) => {
      dot.addEventListener('pointerenter', () => show(i));
      dot.addEventListener('focus', () => show(i));
    });
  }
</script>

<style>
  .sr-ridge__count {
    margin: 0 0 0.5rem;
    color: var(--hero-eyebrow);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sr-ridge__card blockquote {
    margin: 0;
  }

  .sr-ridge__card blockquote p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem);
    font-style: italic;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .sr-ridge__card figcaption {
    margin-block-start: 0.75rem;
    color: var(--hero-muted);
    font-size: 0.9rem;
  }

  .sr-ridge__line {
    position: relative;
    margin-block-start: 1.25rem;
    aspect-ratio: 3 / 1;
  }

  .sr-ridge__line svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sr-ridge__back {
    stroke: var(--text);
    stroke-opacity: 0.14;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .sr-ridge__ridge {
    stroke: var(--text);
    stroke-opacity: 0.55;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .sr-ridge__dots {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sr-ridge__dots li {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    transform: translate(-50%, -50%);
  }

  [dir='rtl'] .sr-ridge__dots li {
    transform: translate(50%, -50%);
  }

  .sr-ridge__dot {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
  }

  .sr-ridge__dot::before {
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--text);
    border-radius: 50%;
    background: var(--chapter-bg, var(--hero-bg));
    content: '';
    transition: transform 0.2s ease;
  }

  .sr-ridge__dot[aria-current='true']::before {
    border-color: var(--link);
    background: var(--link);
    transform: scale(1.5);
  }

  .sr-ridge__dot:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: 50%;
  }

  @media (prefers-reduced-motion: reduce) {
    .sr-ridge__dot::before {
      transition: none;
    }
  }

  @media print {
    .sr-ridge__line {
      display: none;
    }
  }
</style>
