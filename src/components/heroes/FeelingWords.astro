---
/* Wat voel ik?: words to touch. Rendered in two parts, as on the design canvas: the words
   on the visual side (`part="words"`) and the sentence they open under the lead
   (`part="preview"`). Each word is a link to its page; pointing at or focusing it shows its
   sentence. All sentences sit in one grid cell, so the hero never changes height. Without
   JavaScript the words are a row of links and the hint stays. Nothing is stored. */
import { feelingWords } from '../../data/pillar-heroes';
import { cardFor, findByKey } from '../../lib/content';

interface Props {
  locale: string;
  part: 'words' | 'preview';
}
const { locale, part } = Astro.props;
const words = await Promise.all(
  feelingWords.map(async (item) => {
    const entry = await findByKey(locale, item.key);
    if (!entry) throw new Error(`FeelingWords: unknown or unpublished key "${item.key}"`);
    const card = cardFor(entry);
    return { ...item, href: card.href, page: card.title };
  }),
);
const sizes = [1.6, 1.25, 1.45, 1.2, 1.5, 1.25, 1.35, 1.55, 1.2, 1.45, 1.25, 1.15, 1.5, 1.3];
---

{
  part === 'words' ? (
    <ul class="fw-words" data-fw-words>
      {words.map((word, index) => (
        <li>
          <a
            class="fw-word"
            href={word.href}
            data-fw-index={index}
            style={`--size: ${sizes[index % sizes.length]}rem`}
          >
            {word.word}
            <span class="sr-only">: {word.sentence}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div class="fw-preview" data-fw-preview>
      <p class="fw-hint" data-current>
        Raak een woord aan dat in de buurt komt. Je hoeft niets te kiezen.
      </p>
      {words.map((word) => (
        <div class="fw-card">
          <p class="fw-sentence">“{word.sentence}”</p>
          <p class="fw-page">
            <a href={word.href}>{word.page} →</a>
          </p>
        </div>
      ))}
    </div>
  )
}

<script>
  import { previewOnFirstTap } from '../../lib/tap-preview';

  const preview = document.querySelector<HTMLElement>('[data-fw-preview]');
  const items = preview ? [...preview.children] : [];
  for (const word of document.querySelectorAll<HTMLElement>('[data-fw-words] .fw-word')) {
    const show = () => {
      const index = Number(word.dataset.fwIndex) + 1;
      items.forEach((item, i) => item.toggleAttribute('data-current', i === index));
      for (const other of document.querySelectorAll('.fw-word'))
        other.toggleAttribute('data-current', other === word);
    };
    word.addEventListener('pointerenter', (event) => event.pointerType === 'mouse' && show());
    word.addEventListener('focus', show);
    previewOnFirstTap(word, show, () => word.hasAttribute('data-current'));
  }
</script>

<style>
  .fw-words {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 0.85rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fw-word {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid var(--safe-border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 0.6rem + 0.8vw, var(--size));
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .fw-word:is(:hover, :focus-visible, [data-current]) {
    border-color: var(--help);
    background: var(--help);
    color: var(--help-text);
  }

  .fw-word:hover {
    transform: translateY(-2px);
  }

  .fw-word:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  /* Hint and sentences share one cell: the tallest one sets the height. */
  .fw-preview {
    display: grid;
  }

  .fw-preview > * {
    grid-area: 1 / 1;
    align-self: start;
    margin: 0;
  }

  .fw-preview > :not([data-current]) {
    visibility: hidden;
  }

  .fw-hint {
    padding-inline-start: 0.875rem;
    border-inline-start: 3px solid var(--help);
    color: var(--hero-muted);
  }

  .fw-card {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--safe-border);
    border-radius: 1.125rem;
    background: var(--surface);
  }

  .fw-sentence {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .fw-page a {
    color: var(--link);
    text-decoration: none;
  }

  .fw-page {
    margin: 0.5rem 0 0;
    color: var(--link);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .fw-word {
      transition: none;
    }

    .fw-word:hover {
      transform: none;
    }
  }

  @media print {
    .fw-preview {
      display: none;
    }
  }
</style>
