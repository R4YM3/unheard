---
/* Wat voel ik?: words to touch. Each word is a link to its page; pointing at it (or focusing
   it) shows the sentence it stands for. Without JavaScript the words are a plain row of
   links. Nothing is stored. */
import { feelingWords } from '../../data/pillar-heroes';
import { cardFor, findByKey } from '../../lib/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const words = await Promise.all(
  feelingWords.map(async (item) => {
    const entry = await findByKey(locale, item.key);
    if (!entry) throw new Error(`FeelingWords: unknown or unpublished key "${item.key}"`);
    const card = cardFor(entry);
    return { ...item, href: card.href, page: card.title };
  }),
);
const sizes = [1.6, 1.25, 1.45, 1.2, 1.5, 1.25, 1.35, 1.55, 1.2, 1.45, 1.25, 1.15, 1.5, 1.3];
---

<div class="fw" data-feeling-words>
  <ul class="fw__words">
    {
      words.map((word, index) => (
        <li>
          <a
            class="fw__word"
            href={word.href}
            data-sentence={word.sentence}
            data-page={word.page}
            style={`--size: ${sizes[index % sizes.length]}rem`}
          >
            {word.word}
            <span class="sr-only">: {word.sentence}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <div class="fw__preview" aria-hidden="true" data-fw-preview hidden>
    <p class="fw__sentence" data-fw-sentence></p>
    <p class="fw__page"><span data-fw-page></span> →</p>
  </div>
  <p class="fw__hint" data-fw-hint>
    Raak een woord aan dat in de buurt komt. Je hoeft niets te kiezen.
  </p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-feeling-words]')) {
    const preview = root.querySelector<HTMLElement>('[data-fw-preview]');
    const sentence = root.querySelector<HTMLElement>('[data-fw-sentence]');
    const page = root.querySelector<HTMLElement>('[data-fw-page]');
    const hint = root.querySelector<HTMLElement>('[data-fw-hint]');
    if (!preview || !sentence || !page || !hint) continue;
    const show = (word: HTMLElement) => {
      for (const other of root.querySelectorAll('.fw__word')) other.removeAttribute('data-current');
      word.setAttribute('data-current', '');
      sentence.textContent = `“${word.dataset.sentence}”`;
      page.textContent = word.dataset.page ?? '';
      preview.hidden = false;
      hint.hidden = true;
    };
    for (const word of root.querySelectorAll<HTMLElement>('.fw__word')) {
      word.addEventListener('pointerenter', () => show(word));
      word.addEventListener('focus', () => show(word));
    }
  }
</script>

<style>
  .fw__words {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fw__word {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.15rem;
    border: 1px solid var(--safe-border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 0.6rem + 0.8vw, var(--size));
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .fw__word:is(:hover, :focus-visible, [data-current]) {
    border-color: var(--help);
    background: var(--help);
    color: var(--help-text);
  }

  .fw__word:hover {
    transform: translateY(-2px);
  }

  .fw__word:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .fw__preview,
  .fw__hint {
    margin-block-start: 1.25rem;
  }

  .fw__preview {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--safe-border);
    border-radius: 1.125rem;
    background: var(--surface);
  }

  .fw__preview[hidden] {
    display: none;
  }

  .fw__sentence {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .fw__page {
    margin: 0.5rem 0 0;
    color: var(--link);
    font-weight: 700;
  }

  .fw__hint {
    padding-inline-start: 0.875rem;
    border-inline-start: 3px solid var(--help);
    color: var(--hero-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .fw__word {
      transition: none;
    }

    .fw__word:hover {
      transform: none;
    }
  }

  @media print {
    .fw__preview,
    .fw__hint {
      display: none;
    }
  }
</style>
