---
/* Wat voel ik?: words to touch. Rendered in two parts, as on the design canvas: the words
   on the visual side (`part="words"`) and the sentence they open under the lead
   (`part="preview"`). Each word is a link to its page; pointing at or focusing it shows its
   sentence. All sentences sit in one grid cell, so the hero never changes height. Without
   JavaScript the words are a row of links and the hint stays. Nothing is stored. */
import { feelingWords } from '../../data/pillar-heroes';
import { cardFor, findByKey } from '../../lib/content';

interface Props {
  locale: string;
  part: 'words' | 'preview';
}
const { locale, part } = Astro.props;
const words = await Promise.all(
  feelingWords.map(async (item) => {
    const entry = await findByKey(locale, item.key);
    if (!entry) throw new Error(`FeelingWords: unknown or unpublished key "${item.key}"`);
    const card = cardFor(entry);
    return { ...item, href: card.href, page: card.title };
  }),
);
const sizes = [1.6, 1.25, 1.45, 1.2, 1.5, 1.25, 1.35, 1.55, 1.2, 1.45, 1.25, 1.15, 1.5, 1.3];
---

{
  part === 'words' ? (
    <ul class="fw-words" data-fw-words>
      {words.map((word, index) => (
        <li class:list={{ 'fw-words__more': !word.phone }}>
          <a
            class="fw-word"
            href={word.href}
            data-fw-index={index}
            style={`--size: ${sizes[index % sizes.length]}rem`}
          >
            {word.word}
            <span class="sr-only">: {word.sentence}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div class="fw-preview" data-fw-preview>
      <p class="fw-hint" data-current>
        Raak een woord aan dat in de buurt komt. Je hoeft niets te kiezen.
      </p>
      {words.map((word) => (
        <div class="fw-card">
          <p class="fw-sentence">“{word.sentence}”</p>
          <p class="fw-page">
            <a href={word.href}>{word.page} →</a>
          </p>
        </div>
      ))}
      <button
        type="button"
        class="fw-toggle"
        data-fw-toggle
        aria-label="Pauzeer het wisselen"
        title="Pauzeren"
        hidden
      >
        <span class="fw-toggle__pause" aria-hidden="true" />
        <span class="fw-toggle__play" aria-hidden="true" hidden />
      </button>
    </div>
  )
}

<script>
  import { previewOnFirstTap } from '../../lib/tap-preview';

  const preview = document.querySelector<HTMLElement>('[data-fw-preview]');
  const list = document.querySelector<HTMLElement>('[data-fw-words]');
  const items = preview ? [...preview.querySelectorAll(':scope > :is(.fw-hint, .fw-card)')] : [];
  const words = [...document.querySelectorAll<HTMLElement>('[data-fw-words] .fw-word')];
  const toggle = preview?.querySelector<HTMLButtonElement>('[data-fw-toggle]');
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  let current = -1;

  const show = (word: HTMLElement) => {
    const index = Number(word.dataset.fwIndex);
    current = index;
    items.forEach((item, i) => item.toggleAttribute('data-current', i === index + 1));
    for (const other of words) other.toggleAttribute('data-current', other === word);
  };

  /* Every few seconds the next word (of those shown) opens its sentence. It waits while the
     pointer is over the words or the sentence, while focus is inside, and when paused; with
     reduced motion it starts paused. */
  const INTERVAL = 4500;
  let paused = motion.matches;
  let holding = 0;
  let timer: number | undefined;
  const shown = () => words.filter((word) => word.getClientRects().length > 0);
  const step = () => {
    const visible = shown();
    if (visible.length === 0) return;
    const at = visible.findIndex((word) => Number(word.dataset.fwIndex) === current);
    show(visible[(at + 1) % visible.length]);
  };
  const schedule = () => {
    clearInterval(timer);
    timer = undefined;
    if (!paused && holding === 0)
      timer = window.setInterval(() => !document.hidden && step(), INTERVAL);
  };
  const setPaused = (value: boolean) => {
    paused = value;
    if (toggle) {
      toggle.setAttribute('aria-label', paused ? 'Start het wisselen' : 'Pauzeer het wisselen');
      toggle.title = paused ? 'Afspelen' : 'Pauzeren';
      toggle.querySelector<HTMLElement>('.fw-toggle__pause')!.hidden = paused;
      toggle.querySelector<HTMLElement>('.fw-toggle__play')!.hidden = !paused;
    }
    schedule();
  };
  const hold = (area: HTMLElement | null | undefined) => {
    if (!area) return;
    area.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      holding += 1;
      schedule();
    });
    area.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse') return;
      holding = Math.max(0, holding - 1);
      schedule();
    });
    /* Focus on a word or a sentence link holds; focus on the play button does not. */
    area.addEventListener('focusin', (event) => {
      if (event.target === toggle) return;
      holding += 1;
      schedule();
    });
    area.addEventListener('focusout', (event) => {
      if (event.target === toggle) return;
      holding = Math.max(0, holding - 1);
      schedule();
    });
  };

  for (const word of words) {
    word.addEventListener('pointerenter', (event) => event.pointerType === 'mouse' && show(word));
    word.addEventListener('focus', () => show(word));
    /* A tap previews the word and gives it a full turn before the next one. */
    previewOnFirstTap(
      word,
      () => {
        show(word);
        schedule();
      },
      () => word.hasAttribute('data-current'),
    );
  }
  hold(list);
  hold(preview);
  toggle?.addEventListener('click', () => setPaused(!paused));
  motion.addEventListener('change', () => setPaused(motion.matches || paused));

  /* Start with one shown word open, picked at random, so the hint is not needed. */
  const start = shown();
  const first = start[Math.floor(Math.random() * start.length)];
  if (first) show(first);
  if (toggle) toggle.hidden = false;
  setPaused(paused);
</script>

<style>
  .fw-words {
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 0.85rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fw-word {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 1px solid var(--safe-border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 0.6rem + 0.8vw, var(--size));
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .fw-word:is(:hover, :focus-visible, [data-current]) {
    border-color: var(--help);
    background: var(--help);
    color: var(--help-text);
  }

  .fw-word:hover {
    transform: translateY(-2px);
  }

  .fw-word:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  /* Hint and sentences share one cell: the tallest one sets the height. */
  .fw-preview {
    display: grid;
  }

  .fw-preview > :is(.fw-hint, .fw-card) {
    grid-area: 1 / 1;
    align-self: start;
    margin: 0;
  }

  .fw-preview > :is(.fw-hint, .fw-card):not([data-current]) {
    visibility: hidden;
  }

  /* Play/pause for the automatic turns, under the sentence on the end side. */
  /* Its place is kept before the script runs, so the hero does not grow when it appears. */
  .fw-toggle[hidden] {
    display: inline-grid;
    visibility: hidden;
  }

  .fw-toggle {
    display: inline-grid;
    justify-self: end;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-block-start: 0.5rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .fw-toggle:hover {
    border-color: var(--safe-border);
    background: var(--surface);
  }

  .fw-toggle:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .fw-toggle__pause:not([hidden]) {
    display: block;
    width: 0.75rem;
    height: 0.875rem;
    border-inline: 0.25rem solid currentColor;
    box-sizing: border-box;
  }

  .fw-toggle__play:not([hidden]) {
    display: block;
    width: 0.75rem;
    height: 0.875rem;
    background: currentColor;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* On a phone fewer words, spread over the topics; every word still has its page. */
  @media (max-width: 42rem) {
    .fw-words__more {
      display: none;
    }
  }

  .fw-hint {
    padding-inline-start: 0.875rem;
    border-inline-start: 3px solid var(--help);
    color: var(--hero-muted);
  }

  .fw-card {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--safe-border);
    border-radius: 1.125rem;
    background: var(--surface);
  }

  .fw-sentence {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.25;
  }

  .fw-page a {
    color: var(--link);
    text-decoration: none;
  }

  .fw-page {
    margin: 0.5rem 0 0;
    color: var(--link);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .fw-word {
      transition: none;
    }

    .fw-word:hover {
      transform: none;
    }
  }

  @media print {
    .fw-preview {
      display: none;
    }
  }
</style>
