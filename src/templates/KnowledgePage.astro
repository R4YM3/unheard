---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import EntryLayout from '../layouts/EntryLayout.astro';
import HelpChoices from '../components/heroes/HelpChoices.astro';
import PageRail from '../components/PageRail.astro';
import { articleRailGroups } from '../lib/article-rail';
import CardGrid from '../components/CardGrid.astro';
import DarvoGuide from '../components/DarvoGuide.astro';
import FounderNote from '../components/FounderNote.astro';
import MiniReflection from '../components/MiniReflection.astro';
import PerspectiveSwitch from '../components/PerspectiveSwitch.astro';
import { ui } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'patterns'> | CollectionEntry<'articles'>;
}
const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const railGroups = await articleRailGroups(entry, headings);
const cards = 'cards' in data ? data.cards : [];
const founderNote = 'founderNote' in data ? data.founderNote : undefined;
const darvo = 'darvo' in data ? data.darvo : undefined;
const pageType = ['over', 'werkwijze'].includes(data.translationKey) ? 'AboutPage' : 'WebPage';
---

<EntryLayout entry={entry} pageType={pageType} moreLinks={cards}>
  {
    entry.data.locale === 'nl' && entry.data.translationKey === 'hulp-vinden' && (
      <HelpChoices slot="hero-visual" />
    )
  }
  {railGroups.length > 0 && <PageRail slot="rail" groups={railGroups} />}
  <div class="wrap reading prose"><Content /></div>
  <Fragment slot="after">
    {darvo && <DarvoGuide guide={darvo} />}
    {
      data.scenarios.length > 0 && (
        <PerspectiveSwitch scenarios={data.scenarios} locale={data.locale} />
      )
    }
    {
      cards.some((card) => !card.href) && (
        <section class="section section--soft" aria-labelledby="cards-heading">
          <div class="wrap">
            <h2 id="cards-heading">{ui(data.locale).alsoGoodToKnow}</h2>
            <CardGrid items={cards.filter((card) => !card.href)} />
          </div>
        </section>
      )
    }
    {data.reflection && <MiniReflection reflection={data.reflection} />}
    {founderNote && <FounderNote note={founderNote} />}
  </Fragment>
</EntryLayout>
