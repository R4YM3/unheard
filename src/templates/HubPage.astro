---
import { getCollection, type CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import EntryLayout from '../layouts/EntryLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import ProseSlice from '../components/ProseSlice.astro';
import { navigationFor, sectionFor } from '../lib/navigation';
import FounderNote from '../components/FounderNote.astro';
import GlossaryIndex from '../components/GlossaryIndex.astro';
import MiniReflection from '../components/MiniReflection.astro';
import PerspectiveSwitch from '../components/PerspectiveSwitch.astro';
import SearchIndex from '../components/SearchIndex.astro';
import FeelingTimeline from '../components/FeelingTimeline.astro';
import StartChooser from '../components/StartChooser.astro';
import StatsList from '../components/StatsList.astro';
import WordFinder from '../components/WordFinder.astro';
import {
  cardFor,
  findByKey,
  glossaryItems,
  listCollection,
  routeFor,
  searchItems,
} from '../lib/content';
import { itemList, type SchemaNode } from '../lib/schema';
import { ui } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'hubs'>;
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const listings = await Promise.all(
  data.listings.map(async (listing) => ({
    ...listing,
    items: await (async () => {
      const entries = await listCollection(listing.collection, data.locale, listing.prefix);
      const chosen = listing.featured
        ? listing.featured.flatMap((key) =>
            entries.filter((entry) => entry.data.translationKey === key),
          )
        : entries;
      return chosen.map(cardFor);
    })(),
  })),
);
const isEmptyBody = !entry.body?.trim();
const route = routeFor(entry);
/* Hubs weave their explanation and their lists: chapter, list, chapter, list, the rest. */
const woven = listings.length > 0 && !data.finder && !isEmptyBody;
const listingId = (listing: (typeof listings)[number], index: number) =>
  listing.collection === 'emotions' ? 'gevoelens' : `lijst-${index + 1}`;
/* Two hero buttons: down to the first list, and on to a part of this section. */
const nav = navigationFor(data.locale);
const sectionPart = nav
  ? sectionFor(nav, route)?.tabs.find((tab) => tab.href !== route && !route.startsWith(tab.href))
  : undefined;
const heroActions = [
  ...(listings[0]
    ? [{ href: `${route}#${listingId(listings[0], 0)}`, label: `${listings[0].heading} ↓` }]
    : []),
  ...(sectionPart ? [{ href: sectionPart.href, label: sectionPart.label, quiet: true }] : []),
];
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const absolute = (path: string) => new URL(`${basePath}${path}`, site).href;
const pageId = absolute(route);
const listedCards = [
  ...listings.flatMap((listing) =>
    listing.items.map((item) => ({ href: item.href, title: item.title, text: item.text })),
  ),
  ...data.cards.flatMap((card) =>
    card.href ? [{ href: card.href, title: card.title, text: card.text }] : [],
  ),
];
const feelingSteps = data.feelingTimeline
  ? await Promise.all(
      data.feelingTimeline.steps.map(async (step) => {
        const linked = await findByKey(data.locale, step.key);
        if (!linked) throw new Error(`Feeling timeline: unknown or unpublished key "${step.key}"`);
        return { href: routeFor(linked), title: cardFor(linked).title, text: step.text };
      }),
    )
  : [];
const feelingList = itemList(
  `${pageId}#tijdlijn`,
  data.feelingTimeline?.heading ?? '',
  feelingSteps,
  pageId,
  absolute,
);
const cardList = itemList(`${pageId}#paginas`, data.heading, listedCards, pageId, absolute);
const searchList = data.searchIndex
  ? itemList(
      `${pageId}#alle-paginas`,
      'Alle pagina’s',
      (await searchItems(data.locale)).map((item) => ({
        href: item.href,
        title: item.title,
        text: item.text,
      })),
      pageId,
      absolute,
    )
  : undefined;
const terms = data.glossaryIndex ? await glossaryItems(data.locale) : [];
const termSetId = absolute(`${data.locale}/begrippen/#termen`);
const termSet: SchemaNode | undefined =
  terms.length > 0
    ? {
        '@type': 'DefinedTermSet',
        '@id': termSetId,
        name: 'Alle begrippen',
        description: data.lead,
        hasDefinedTerm: terms.map((term) => ({
          '@type': 'DefinedTerm',
          name: term.term,
          description: term.definition,
          url: absolute(term.href),
        })),
      }
    : undefined;
const figures = data.stats
  ? (await getCollection('stats', ({ data: figure }) => figure.verified)).sort(
      (a, b) => a.data.order - b.data.order,
    )
  : [];
const figureList = itemList(
  `${pageId}#cijfers`,
  'De cijfers, met hun grenzen',
  figures.map(({ data: figure }) => ({
    title: `${figure.value} ${figure.label}`,
    text: figure.explanation,
  })),
  pageId,
  absolute,
);
const extraSchema = [cardList, feelingList, searchList, termSet, figureList].filter(
  (node): node is SchemaNode => Boolean(node),
);
const mainEntityId = termSet
  ? termSetId
  : figureList
    ? `${pageId}#cijfers`
    : searchList
      ? `${pageId}#alle-paginas`
      : cardList
        ? `${pageId}#paginas`
        : undefined;
---

<EntryLayout
  entry={entry}
  heading={data.heading}
  eyebrow={data.hero?.eyebrow ?? data.eyebrow}
  lead={data.lead}
  pageType={data.finder ? 'WebPage' : 'CollectionPage'}
  articleType={false}
  showSources={data.sources.length > 0}
  showHelp={data.translationKey !== 'zoeken'}
  extraSchema={extraSchema}
  mainEntityId={mainEntityId}
  moreLinks={data.cards}
  actions={heroActions}
>
  {
    !woven && !isEmptyBody && (
      <div class="wrap reading prose">
        <Content />
      </div>
    )
  }
  {!woven && data.chooser && <StartChooser locale={data.locale} />}
  {data.finder && <WordFinder id={data.finder} locale={data.locale} />}
  {
    listings.map((listing, index) => (
      <>
        {woven && (
          <ProseSlice from={index} to={index + 1}>
            <Content />
          </ProseSlice>
        )}
        <section
          class:list={[
            'section',
            {
              'section--tension': listing.tone === 'tension',
              'section--soft': listing.tone === 'safe',
              'section--tint': listing.tone !== 'tension' && listing.tone !== 'safe',
              'section--tape': listing.tape,
            },
          ]}
          aria-labelledby={`listing-${index}-heading`}
          id={listingId(listing, index)}
        >
          <div class="wrap">
            <h2 id={`listing-${index}-heading`}>{listing.heading}</h2>
            {listing.lead && <p class="reading">{listing.lead}</p>}
            {listing.items.length > 0 && listing.cardStyle === 'feeling' ? (
              <div class="grid grid--3">
                {listing.items.map((item) => (
                  <a class="card feeling-card" href={item.href}>
                    {item.eyebrow && <p class="eyebrow">{item.eyebrow}</p>}
                    <h3>{item.title}</h3>
                    {item.text && <p>{item.text}</p>}
                  </a>
                ))}
              </div>
            ) : listing.items.length > 0 ? (
              <CardGrid
                items={listing.items.map((item) => ({
                  ...item,
                  tone: listing.tone === 'tension' ? ('tension' as const) : ('neutral' as const),
                }))}
              />
            ) : (
              <p class="note">{ui(data.locale).pagesComingSoon}</p>
            )}
            {listing.more && (
              <p class="listing-more">
                <a class="button button--quiet" href={listing.more.href}>
                  {listing.more.label}
                </a>
              </p>
            )}
          </div>
        </section>
      </>
    ))
  }
  {
    woven && (
      <ProseSlice from={listings.length}>
        <Content />
      </ProseSlice>
    )
  }
  {woven && data.chooser && <StartChooser locale={data.locale} />}
  {data.feelingTimeline && <FeelingTimeline timeline={data.feelingTimeline} locale={data.locale} />}
  {
    data.cards.some((card) => !card.href) && (
      <section class="section" aria-labelledby="hub-cards-heading">
        <div class="wrap">
          <h2 id="hub-cards-heading">{ui(data.locale).alsoGoodToKnow}</h2>
          <CardGrid items={data.cards.filter((card) => !card.href)} />
        </div>
      </section>
    )
  }
  {
    data.glossaryIndex && (
      <GlossaryIndex locale={data.locale} pagePath={`${data.locale}/${data.slug}/`} />
    )
  }
  {data.stats && <StatsList />}
  {data.searchIndex && <SearchIndex locale={data.locale} />}
  {
    data.scenarios.length > 0 && (
      <PerspectiveSwitch scenarios={data.scenarios} locale={data.locale} />
    )
  }
  {data.reflection && <MiniReflection reflection={data.reflection} />}
  {data.founderNote && <FounderNote note={data.founderNote} />}
</EntryLayout>
