---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import EntryLayout from '../layouts/EntryLayout.astro';
import ArticleBody from '../components/ArticleBody.astro';
import ArticleContents from '../components/ArticleContents.astro';
import { articleContentsGroups } from '../lib/article-contents';
import Marked from '../components/Marked.astro';
import { REVIEW_MARKER } from '../lib/review-marks';

interface Props {
  entry: CollectionEntry<'therapies'>;
}
const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const contentsGroups = articleContentsGroups(entry, headings);
/* Lower-case the name inside a sentence, but keep acronyms such as EMDR. */
const inSentence = (name: string) =>
  /^[A-Z]{2,}\b/.test(name) ? name : name.charAt(0).toLowerCase() + name.slice(1);
---

<EntryLayout
  entry={entry}
  eyebrow={data.hero?.eyebrow ?? `Herstel / Therapievormen / ${data.name}`}
>
  {contentsGroups.length > 0 && <ArticleContents slot="contents" groups={contentsGroups} />}
  {
    /* One summary per page: the focus line only stands in when there is no summary. */
    !data.summary && (
      <div class="wrap reading">
        <p class="summary-box">
          <strong>Waar richt het zich op?</strong> {data.focus}
        </p>
      </div>
    )
  }
  <ArticleBody fragments={data.recognitionFragments}><Content /></ArticleBody>
  <Fragment slot="after">
    <section class="section section--block" aria-labelledby="vragen-heading" id="vragen">
      <div class="wrap reading">
        <p class="eyebrow">Voor een gesprek met een professional</p>
        <h2 id="vragen-heading">Vragen die je kunt stellen</h2>
        <ol class="questions-list">
          {data.professionalQuestions.map((question) => <li>{question}</li>)}
        </ol>
        <p class="note">
          Of een therapievorm bij jou past, bepaal je samen met een bevoegde professional,
          bijvoorbeeld via je huisarts.
        </p>
      </div>
    </section>
    {
      data.founder && (
        <section
          class:list={[
            'section',
            'section--therapy',
            {
              'needs-review': data.founder.text.every((paragraph) =>
                paragraph.includes(REVIEW_MARKER),
              ),
            },
          ]}
          aria-labelledby="ervaring-heading"
          id="mijn-ervaring"
        >
          <div class="wrap">
            <div class="card card--story founder-note">
              <p class="eyebrow">Persoonlijke ervaring · ik-passage</p>
              <h2 id="ervaring-heading">Mijn ervaring met {inSentence(data.name)}</h2>
              {data.founder.text.map((paragraph) => (
                <p>
                  <Marked text={paragraph} />
                </p>
              ))}
              <p class="note">
                Dit is de ervaring van de oprichter, geen behandeladvies en geen uitspraak over wat
                voor een ander werkt.
                {data.founder.needsReview && ' Deze passage wordt nog door hem bevestigd.'}
              </p>
            </div>
          </div>
        </section>
      )
    }
  </Fragment>
</EntryLayout>
