---
import type { CollectionEntry } from 'astro:content';
import EntryLayout from '../layouts/EntryLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import HeroArt from '../components/HeroArt.astro';
import PerspectiveSwitch from '../components/PerspectiveSwitch.astro';
import HomeHeroConversations from '../components/HomeHeroConversations.astro';
import HomePerspectiveCarousel from '../components/HomePerspectiveCarousel.astro';
import StartChooser from '../components/StartChooser.astro';
import WordFinderInvite from '../components/WordFinderInvite.astro';
import { routeFor } from '../lib/content';
import { itemList, type SchemaNode } from '../lib/schema';

interface Props {
  entry: CollectionEntry<'hubs'>;
}
const { entry } = Astro.props;
const { data } = entry;
const home = data.home;
const dutch = data.locale === 'nl';
if (!home) throw new Error(`HomePage requires a home block; received ${entry.id}.`);
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const absolute = (path: string) => new URL(`${basePath}${path}`, site).href;
const pageId = absolute(routeFor(entry));
const homeLists = [
  itemList(
    `${pageId}#gevoelens`,
    home.feelings.heading,
    home.feelings.cards.map((card) => ({ href: card.href, title: card.title })),
    pageId,
    absolute,
  ),
  itemList(
    `${pageId}#herstel`,
    home.resources.heading,
    home.resources.cards.map((card) => ({
      href: card.href,
      title: card.title,
      text: card.description,
    })),
    pageId,
    absolute,
  ),
].filter((node): node is SchemaNode => Boolean(node));
---

<EntryLayout
  entry={entry}
  hero={false}
  heading={data.heading}
  articleType={false}
  showSummary={false}
  showHelp={false}
  showSources={false}
  extraSchema={homeLists}
  mainEntityId={homeLists[0] ? `${pageId}#gevoelens` : undefined}
>
  <section class:list={['hero', { 'hero--home': dutch }]} id="top">
    <div class:list={['wrap home-hero__grid', { 'home-hero__grid--conversation': dutch }]}>
      <div class="home-hero__copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>{data.heading}</h1>
        <p class="lead">{home.hero.lead}</p>
        {!dutch && <p>{home.hero.description}</p>}
        <div class="actions">
          <a class="button" href={home.hero.primary.href}>{home.hero.primary.label}</a>
          <a class="button button--quiet" href={home.hero.secondary.href}
            >{home.hero.secondary.label}</a
          >
        </div>
      </div>
      {
        dutch && (
          <div class="home-hero-visual" id="gesprekschat">
            <HomeHeroConversations scenarios={data.scenarios} />
          </div>
        )
      }
      {!dutch && <HeroArt slot="home" priority />}
    </div>
  </section>
  <section
    class:list={['section', dutch ? 'chapter--recognition' : 'section--tape']}
    aria-labelledby="gevoelens-heading"
    id="gevoelens"
  >
    <div class="wrap">
      <div class:list={['section-heading', { 'feelings-heading': dutch }]}>
        <div>
          <p class="eyebrow">{dutch ? 'Wat voel ik?' : home.feelings.eyebrow}</p>
          <h2 id="gevoelens-heading">{home.feelings.heading}</h2>
        </div>
        {
          dutch ? (
            <a class="button button--quiet" href={home.feelings.moreHref}>
              {home.feelings.moreLabel} →
            </a>
          ) : (
            <p>{home.feelings.lead}</p>
          )
        }
      </div>
      <div class="grid grid--3">
        {
          home.feelings.cards.map((card) => (
            <a class="card feeling-card" href={card.href}>
              <p class="eyebrow">{card.eyebrow}</p>
              <h3>{card.title}</h3>
            </a>
          ))
        }
      </div>
      {
        !dutch && (
          <p class="listing-more">
            <a class="button button--quiet" href={home.feelings.moreHref}>
              {home.feelings.moreLabel} →
            </a>
          </p>
        )
      }
    </div>
  </section>
  {
    dutch ? (
      <>
        <StartChooser
          locale={data.locale}
          chapter={{ eyebrow: 'Hulpmiddelen', wordFinder: home.wordFinder }}
        />
        <HomePerspectiveCarousel
          scenarios={data.scenarios}
          start={2}
          eyebrow="Begrijp het"
          heading={home.perspective.heading}
          lead={home.perspective.lead}
          more={{ href: 'nl/begrijp-het/', label: 'Alles over Begrijp het' }}
        />
        <section
          class="section section--chapter chapter--story"
          aria-labelledby="verhaal-heading"
          id="verhaal"
        >
          <div class="wrap home-story">
            <div class="home-story__quotes">
              <p class="eyebrow home-story__eyebrow">
                <a href={home.storyTeaser.href}>Mijn verhaal</a>
              </p>
              <blockquote class="home-story-quote">
                <p>“Als ik iets wilde, kon ik dagen nadenken over hoe ik het moest brengen.”</p>
              </blockquote>
              <blockquote class="home-story-quote">
                <p>
                  “Ook nadat ik was weggegaan, twijfelde ik nog aan mezelf en mijn herinneringen.”
                </p>
              </blockquote>
            </div>
            <div class="home-story__card">
              <p class="eyebrow">{home.storyTeaser.eyebrow}</p>
              <h2 id="verhaal-heading">{home.storyTeaser.heading}</h2>
              {/* As on the canvas: the last paragraph only. The first paragraph and the old hero
                  description stay in the content file for the founder to place. */}
              <p>{home.storyTeaser.paragraphs.at(-1)}</p>
              <div class="actions">
                <a class="button" href={home.storyTeaser.href}>
                  {home.storyTeaser.label}
                </a>
                <a class="button button--quiet" href={home.timelineTeaser.href}>
                  {home.timelineTeaser.label}
                </a>
              </div>
              <p class="home-story__why">
                <a class="text-link" href="nl/over/#waarom-ik-hiermee-begon">
                  Waarom ik Ongehoord begon
                </a>
              </p>
            </div>
          </div>
        </section>
      </>
    ) : (
      <>
        {home.wordFinder && <WordFinderInvite {...home.wordFinder} />}
        {data.scenarios.length > 0 && (
          <PerspectiveSwitch
            scenarios={data.scenarios}
            locale={data.locale}
            heading={home.perspective.heading}
            intro={home.perspective.lead}
            layout="split"
            swipe
          >
            <p>
              Wil je met iemand bespreken wat je herkent?{' '}
              <a href="nl/hulp-vinden/">Bekijk waar je terechtkunt voor advies</a>.
            </p>
          </PerspectiveSwitch>
        )}
      </>
    )
  }
  {
    !dutch && (
      <section class="section section--paper" aria-labelledby="verhaal-heading" id="verhaal">
        <div class="wrap reading">
          <div>
            <p class="eyebrow">{home.storyTeaser.eyebrow}</p>
            <h2 id="verhaal-heading">{home.storyTeaser.heading}</h2>
            {home.storyTeaser.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <p>
              Zoek je herkenning of wil je weten of iemand anders dit ook voelde? In mijn verhaal
              lees je hoe het voor mij was.
            </p>
            <div class="actions">
              <a class="button" href={home.storyTeaser.href}>
                {home.storyTeaser.label}
              </a>
              <a class="text-link" href={home.timelineTeaser.href}>
                {home.timelineTeaser.label}
              </a>
              <a class="text-link" href="nl/over/#waarom-ik-hiermee-begon">
                Waarom ik Ongehoord begon
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }
  <section
    class:list={['section', dutch ? 'section--chapter chapter--recovery' : 'section--soft']}
    aria-labelledby="herstel-heading"
    id="herstel"
  >
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{dutch ? 'Herstel' : home.resources.eyebrow}</p>
          <h2 id="herstel-heading">{home.resources.heading}</h2>
          {
            dutch && (
              <p>
                Misschien wil je weer voelen wat je zelf wilt, oefenen met grenzen of met iemand
                praten over wat je meemaakt.
              </p>
            )
          }
        </div>
      </div>
      <CardGrid
        columns={home.resources.cards.length % 3 === 0 ? 3 : 2}
        items={home.resources.cards.map((card) => ({
          eyebrow: card.eyebrow,
          title: card.title,
          text: card.description,
          href: card.href,
          label: card.label,
          /* White cards on the sage band, so each link stands out. */
          tone: 'neutral' as const,
        }))}
      />
    </div>
  </section>
  <section class="section section--chrome" aria-labelledby="slot-heading" id="hulp">
    <div class="wrap reading">
      <p class="eyebrow">{home.closing.eyebrow}</p>
      <h2 id="slot-heading">{home.closing.heading}</h2>
      <p>{home.closing.description}</p>
      <div class="actions">
        <a class="button" href={home.closing.href}>{home.closing.label}</a>
      </div>
      <p class="note">{home.closing.note}</p>
    </div>
  </section>
</EntryLayout>

<style>
  /* Mijn verhaal: the founder's own words on the start side, why the site exists on a card
     beside them. The ridge pattern runs along the bottom of the band, under the card. */
  .home-story {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .home-story__eyebrow {
    margin: 0;
  }

  .home-story__eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .home-story__eyebrow a:hover {
    text-decoration: underline;
  }

  .home-story__quotes {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .home-story-quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .home-story-quote p {
    margin: 0;
  }

  .home-story-quote + .home-story-quote {
    margin-top: clamp(0.75rem, 2vw, 1.5rem);
  }

  .home-story__card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--chapter-line);
    border-radius: 1.25rem;
    background: var(--surface);
  }

  .home-story__card h2 {
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.25rem);
  }

  @media (min-width: 52rem) {
    .home-story {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: clamp(2rem, 4vw, 3rem);
    }
  }

  .home-story__why {
    margin: 1rem 0 0;
  }

  .home-story-quote p {
    margin: 0;
  }

  .home-hero-visual {
    display: grid;
    min-width: 0;
  }

  .feelings-heading h2 {
    margin-block-end: 0;
  }
  @media (max-width: 42rem) {
    .feelings-heading > .button {
      margin-block-start: 1rem;
    }

    #gevoelens .feeling-card {
      min-height: 0;
      padding: 1rem 1.125rem;
    }

    #gevoelens .feeling-card h3 {
      font-size: 1.4rem;
    }
  }
  /* The heading comes first in the page; on a wide screen the conversation sits beside it,
     on the start side, as before. */
  @media (width > 52rem) {
    .home-hero__grid--conversation {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1.1fr);
    }

    .home-hero__grid--conversation {
      align-items: center;
    }

    /* Room above and below, equal, so the controls under the centred chat stay inside. */
    .home-hero__grid--conversation .home-hero__copy {
      padding-block: clamp(4.5rem, 7vw, 6rem);
    }

    .home-hero__grid--conversation .home-hero-visual {
      order: -1;
    }
  }

  /* Phone (canvas board J, variant C): the heading as the statement, the conversation right
     below it with a little air around, then the lead and both buttons, all in the first
     screen. The copy's children join the hero grid so the chat can sit between them; the
     source order (heading, lead, buttons, chat) stays as on wide screens. */
  @media (max-width: 52rem) {
    .home-hero__grid--conversation {
      gap: 0;
      padding-block: 1.75rem 2.5rem;
    }

    .home-hero__grid--conversation .home-hero__copy {
      display: contents;
    }

    .home-hero__grid--conversation .home-hero__copy > .eyebrow {
      display: none;
    }

    .home-hero__grid--conversation h1 {
      order: -2;
      margin: 0 0 1.25rem;
      font-size: clamp(1.65rem, 7vw, 2rem);
    }

    .home-hero__grid--conversation .home-hero-visual {
      order: -1;
      margin-block-end: 1.5rem;
    }

    .home-hero__grid--conversation .lead {
      margin: 0 0 1rem;
      font-size: 1rem;
    }

    .home-hero__grid--conversation .actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin: 0;
    }

    .home-hero__grid--conversation .actions .button {
      min-height: 2.75rem;
      padding-inline: 0.75rem;
      font-size: 0.875rem;
    }
  }
</style>
