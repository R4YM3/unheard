---
import type { CollectionEntry } from 'astro:content';
import EntryLayout from '../layouts/EntryLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import HeroArt from '../components/HeroArt.astro';
import PerspectiveSwitch from '../components/PerspectiveSwitch.astro';
import HomeConversation from '../components/HomeConversation.astro';
import HomeHeroConversations from '../components/HomeHeroConversations.astro';
import StartChooser from '../components/StartChooser.astro';
import WordFinderInvite from '../components/WordFinderInvite.astro';
import { routeFor } from '../lib/content';
import { itemList, type SchemaNode } from '../lib/schema';

interface Props {
  entry: CollectionEntry<'hubs'>;
}
const { entry } = Astro.props;
const { data } = entry;
const home = data.home;
const dutch = data.locale === 'nl';
if (!home) throw new Error(`HomePage requires a home block; received ${entry.id}.`);
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const absolute = (path: string) => new URL(`${basePath}${path}`, site).href;
const pageId = absolute(routeFor(entry));
const homeLists = [
  itemList(
    `${pageId}#gevoelens`,
    home.feelings.heading,
    home.feelings.cards.map((card) => ({ href: card.href, title: card.title })),
    pageId,
    absolute,
  ),
  itemList(
    `${pageId}#herstel`,
    home.resources.heading,
    home.resources.cards.map((card) => ({
      href: card.href,
      title: card.title,
      text: card.description,
    })),
    pageId,
    absolute,
  ),
].filter((node): node is SchemaNode => Boolean(node));
---

<EntryLayout
  entry={entry}
  hero={false}
  heading={data.heading}
  articleType={false}
  showSummary={false}
  showHelp={false}
  showSources={false}
  extraSchema={homeLists}
  mainEntityId={homeLists[0] ? `${pageId}#gevoelens` : undefined}
>
  <section class="hero" id="top">
    <div class:list={['wrap home-hero__grid', { 'home-hero__grid--conversation': dutch }]}>
      {
        dutch && (
          <div class="home-hero-visual">
            <HomeHeroConversations scenarios={data.scenarios} />
          </div>
        )
      }
      <div class="home-hero__copy">
        <p class="eyebrow">{home.hero.eyebrow}</p>
        <h1>{data.heading}</h1>
        <p class="lead">{home.hero.lead}</p>
        <p>{home.hero.description}</p>
        <div class="actions">
          <a class="button" href={home.hero.primary.href}>{home.hero.primary.label}</a>
          <a class="button button--quiet" href={home.hero.secondary.href}
            >{home.hero.secondary.label}</a
          >
        </div>
      </div>
      {!dutch && <HeroArt slot="home" priority />}
    </div>
  </section>
  <section
    class:list={['section', { 'section--tape': !dutch }]}
    aria-labelledby="gevoelens-heading"
    id="gevoelens"
  >
    <div class="wrap">
      <div class:list={['section-heading', { 'feelings-heading': dutch }]}>
        <div>
          <p class="eyebrow">{home.feelings.eyebrow}</p>
          <h2 id="gevoelens-heading">{home.feelings.heading}</h2>
        </div>
        {
          dutch ? (
            <a class="button button--quiet" href={home.feelings.moreHref}>
              {home.feelings.moreLabel} →
            </a>
          ) : (
            <p>{home.feelings.lead}</p>
          )
        }
      </div>
      <div class="grid grid--3">
        {
          home.feelings.cards.map((card) => (
            <a class="card feeling-card" href={card.href}>
              <p class="eyebrow">{card.eyebrow}</p>
              <h3>{card.title}</h3>
            </a>
          ))
        }
      </div>
      {
        !dutch && (
          <p class="listing-more">
            <a class="button button--quiet" href={home.feelings.moreHref}>
              {home.feelings.moreLabel} →
            </a>
          </p>
        )
      }
    </div>
  </section>
  {
    dutch ? (
      <>
        {data.scenarios[0] && (
          <HomeConversation
            id="perspectief-scene-0"
            sectionId="perspectief"
            scenario={data.scenarios[0]}
            concept={{ href: 'nl/begrippen/gaslighting/', label: 'Wat is gaslighting?' }}
          />
        )}
        <div class="section" id="gedachte">
          <div class="wrap reading">
            <p class="eyebrow home-thought-label">
              <a href={home.timelineTeaser.href}>Uit mijn verhaal</a>
            </p>
            <blockquote class="home-story-quote">
              <p>“Als ik iets wilde, kon ik dagen nadenken over hoe ik het moest brengen.”</p>
            </blockquote>
          </div>
        </div>
        <StartChooser locale={data.locale} columns />
        <div class="section home-story-quote-band" id="verhaal-citaat">
          <div class="wrap reading">
            <blockquote class="home-story-quote">
              <p>
                “Ook nadat ik was weggegaan, twijfelde ik nog aan mezelf en mijn herinneringen.”
              </p>
            </blockquote>
            <div class="actions">
              <a class="button button--quiet" href={home.timelineTeaser.href}>
                {home.timelineTeaser.label}
              </a>
            </div>
          </div>
        </div>
        {data.scenarios[2] && (
          <HomeConversation id="perspectief-scene-2" scenario={data.scenarios[2]} />
        )}
        {home.wordFinder && <WordFinderInvite {...home.wordFinder} />}
      </>
    ) : (
      <>
        {home.wordFinder && <WordFinderInvite {...home.wordFinder} />}
        {data.scenarios.length > 0 && (
          <PerspectiveSwitch
            scenarios={data.scenarios}
            locale={data.locale}
            heading={home.perspective.heading}
            intro={home.perspective.lead}
            layout="split"
            swipe
          >
            <p>
              Wil je met iemand bespreken wat je herkent?{' '}
              <a href="nl/hulp-vinden/">Bekijk waar je terechtkunt voor advies</a>.
            </p>
          </PerspectiveSwitch>
        )}
      </>
    )
  }
  <section class="section section--paper" aria-labelledby="verhaal-heading" id="verhaal">
    <div class="wrap reading">
      <div>
        <p class="eyebrow">{home.storyTeaser.eyebrow}</p>
        <h2 id="verhaal-heading">{home.storyTeaser.heading}</h2>
        {home.storyTeaser.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {
          !dutch && (
            <p>
              Zoek je herkenning of wil je weten of iemand anders dit ook voelde? In mijn verhaal
              lees je hoe het voor mij was.
            </p>
          )
        }
        <div class="actions">
          <a class="button" href={home.storyTeaser.href}>{home.storyTeaser.label}</a>
          {
            !dutch && (
              <a class="text-link" href={home.timelineTeaser.href}>
                {home.timelineTeaser.label}
              </a>
            )
          }
          <a class="text-link" href="nl/over/#waarom-ik-hiermee-begon">Waarom ik Ongehoord begon</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section section--soft" aria-labelledby="herstel-heading" id="herstel">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{home.resources.eyebrow}</p>
          <h2 id="herstel-heading">{home.resources.heading}</h2>
          {
            dutch && (
              <p>
                Misschien wil je weer voelen wat je zelf wilt, oefenen met grenzen of met iemand
                praten over wat je meemaakt.
              </p>
            )
          }
        </div>
      </div>
      <CardGrid
        columns={home.resources.cards.length % 3 === 0 ? 3 : 2}
        items={home.resources.cards.map((card) => ({
          eyebrow: card.eyebrow,
          title: card.title,
          text: card.description,
          href: card.href,
          label: card.label,
          /* White cards on the sage band, so each link stands out. */
          tone: 'neutral' as const,
        }))}
      />
    </div>
  </section>
  <section class="section section--chrome" aria-labelledby="slot-heading" id="hulp">
    <div class="wrap reading">
      <p class="eyebrow">{home.closing.eyebrow}</p>
      <h2 id="slot-heading">{home.closing.heading}</h2>
      <p>{home.closing.description}</p>
      <div class="actions">
        <a class="button" href={home.closing.href}>{home.closing.label}</a>
      </div>
      <p class="note">{home.closing.note}</p>
    </div>
  </section>
</EntryLayout>

<style>
  .home-story-quote-band .actions {
    justify-content: center;
    margin-block-start: 1.5rem;
  }

  .home-thought-label {
    text-align: center;
  }

  .home-story-quote {
    margin: 0;
    text-align: center;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    line-height: 1.2;
  }

  .home-story-quote p {
    margin: 0;
  }

  .home-hero-visual {
    display: grid;
    min-width: 0;
  }

  .feelings-heading h2 {
    margin-block-end: 0;
  }
  @media (max-width: 42rem) {
    .feelings-heading > .button {
      margin-block-start: 1rem;
    }

    #gevoelens .feeling-card {
      min-height: 0;
      padding: 1rem 1.125rem;
    }

    #gevoelens .feeling-card h3 {
      font-size: 1.4rem;
    }
  }
  @media (width > 52rem) {
    .home-hero__grid--conversation {
      grid-template-columns: minmax(18rem, 0.9fr) minmax(0, 1.1fr);
    }
  }

  @media (max-width: 52rem) {
    .home-hero-visual {
      padding-block-start: 1rem;
    }

    .home-hero__grid--conversation .home-hero__copy {
      padding-block-start: 0.75rem;
    }
  }
</style>
