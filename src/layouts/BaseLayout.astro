---
import '../styles/global.css';
import '../styles/print.css';
import { type Locale } from '../i18n/config';
import ThemeToggle from '../components/ThemeToggle.astro';
import LocaleSelector from '../components/LocaleSelector.astro';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
}
const { title, description, locale = 'nl', canonicalPath = '/' } = Astro.props;
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(`${basePath}${canonicalPath.replace(/^\//, '')}`, site).href;
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  inLanguage: locale,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: 'Ongehoord', url: site.href },
};
const hasHomeTranslations = ['/nl/', '/en/', '/ar/'].includes(canonicalPath);
const noIndex = process.env.NO_INDEX === 'true';
const alternateUrl = (language: Locale) => new URL(`${basePath}${language}/`, site).href;
const navigation =
  locale === 'nl'
    ? [
        ['nl/wat-voel-ik/', 'Wat voel ik?'],
        ['nl/begrippen/', 'Begrijp het'],
        ['nl/herstel/', 'Herstel'],
        ['nl/mijn-verhaal/', 'Mijn verhaal'],
        ['nl/hulp-vinden/', 'Hulp vinden'],
      ]
    : [[`${locale}/`, locale === 'ar' ? 'الصفحة الرئيسية' : 'Home']];
---

<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ongehoord" />
    <meta property="og:title" content={`${title} — Ongehoord`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <base href={basePath} />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {
      hasHomeTranslations && (
        <>
          <>
            <link rel="alternate" hreflang="nl" href={alternateUrl('nl')} />
            <link rel="alternate" hreflang="en" href={alternateUrl('en')} />
            <link rel="alternate" hreflang="ar" href={alternateUrl('ar')} />
            <link rel="alternate" hreflang="x-default" href={alternateUrl('en')} />
          </>
        </>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title} — Ongehoord</title>
    <script
      is:inline
      set:html={`(()=>{try{const t=localStorage.getItem('ongehoord-theme');const d=t==='dark'||t==='light'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d}catch{}})()`}
    />
  </head>
  <body>
    <a class="skip" href="#main">Direct naar inhoud</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="nl/">Ongehoord<span>.</span></a>
        <nav
          class="nav"
          aria-label={locale === 'ar'
            ? 'التنقل الرئيسي'
            : locale === 'en'
              ? 'Main navigation'
              : 'Hoofdnavigatie'}
        >
          {navigation.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <LocaleSelector /><ThemeToggle />
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <strong>Ongehoord.</strong> Voor alles wat je voelt, maar nog niet kunt verwoorden.
      </div>
    </footer>
  </body>
</html>
