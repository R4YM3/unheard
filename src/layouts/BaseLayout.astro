---
import '../styles/global.css';
import '../styles/print.css';
import { type Locale } from '../i18n/config';
import ThemeToggle from '../components/ThemeToggle.astro';
import LocaleSelector from '../components/LocaleSelector.astro';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  indexable?: boolean;
  alternates?: Array<{ locale: Locale; path: string }>;
}
const {
  title,
  description,
  locale = 'nl',
  canonicalPath = '/',
  indexable = true,
  alternates = [],
} = Astro.props;
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonical = new URL(`${basePath}${canonicalPath.replace(/^\//, '')}`, site).href;
const alternateUrls = alternates.map(({ locale: alternateLocale, path }) => ({
  locale: alternateLocale,
  href: new URL(`${basePath}${path.replace(/^\//, '')}`, site).href,
}));
const defaultAlternate = alternateUrls.find(
  ({ locale: alternateLocale }) => alternateLocale === 'nl',
);
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const brandName = locale === 'nl' ? 'Ongehoord' : 'Unheard';
const websiteId = new URL('#website', site).href;
const organizationId = new URL('#organization', site).href;
const logoUrl = new URL(`${basePath}logo.svg`, site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Unheard',
    url: site.href,
    logo: { '@type': 'ImageObject', url: logoUrl, width: 256, height: 256 },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: brandName,
    url: site.href,
    inLanguage: locale,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonical,
    name: title,
    description,
    inLanguage: locale,
    url: canonical,
    isPartOf: { '@id': websiteId },
  },
];
const noIndex = process.env.NO_INDEX === 'true' || !indexable;
const cloudflareBeaconToken = import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN;
const skipLabel =
  locale === 'nl'
    ? 'Direct naar inhoud'
    : locale === 'ar'
      ? 'انتقل إلى المحتوى'
      : 'Skip to content';
const navigation =
  locale === 'nl'
    ? [
        ['nl/', 'Home'],
        ['nl/wat-voel-ik/', 'Wat voel ik?'],
        ['nl/begrippen/', 'Begrijp het'],
        ['nl/herstel/', 'Herstel'],
        ['nl/mijn-verhaal/', 'Mijn verhaal'],
        ['nl/hulp-vinden/', 'Hulp vinden'],
      ]
    : [[`${locale}/`, locale === 'ar' ? 'الصفحة الرئيسية' : 'Home']];
---

<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={`${title} — ${brandName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <base href={basePath} />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {
      alternateUrls.map(({ locale: alternateLocale, href }) => (
        <link rel="alternate" hreflang={alternateLocale} href={href} />
      ))
    }
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {
      cloudflareBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken, spa: false })}
        />
      )
    }
    <title>{title} — {brandName}</title>
    <script
      is:inline
      set:html={`(()=>{try{const t=localStorage.getItem('ongehoord-theme');const d=t==='dark'||t==='light'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d}catch{}})()`}
    />
  </head>
  <body>
    <a class="skip" href="#main">{skipLabel}</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={`${locale}/`}>{brandName}<span>.</span></a>
        <nav
          class="nav"
          aria-label={locale === 'ar'
            ? 'التنقل الرئيسي'
            : locale === 'en'
              ? 'Main navigation'
              : 'Hoofdnavigatie'}
        >
          {
            navigation.map(([href, label]) => (
              <a class:list={{ 'nav-help': label === 'Hulp vinden' }} href={href}>
                {label}
              </a>
            ))
          }
        </nav>
        <details class="mobile-menu">
          <summary
            aria-label={locale === 'nl'
              ? 'Menu openen'
              : locale === 'ar'
                ? 'فتح القائمة'
                : 'Open menu'}
          >
            <span></span><span></span><span></span>
            <span class="sr-only"
              >{locale === 'nl' ? 'Menu' : locale === 'ar' ? 'القائمة' : 'Menu'}</span
            >
          </summary>
          <nav
            class="mobile-menu__panel"
            aria-label={locale === 'ar'
              ? 'التنقل الرئيسي'
              : locale === 'en'
                ? 'Main navigation'
                : 'Hoofdnavigatie'}
          >
            {navigation.map(([href, label]) => <a href={href}>{label}</a>)}
          </nav>
        </details>
        <div class="header-controls"><LocaleSelector locale={locale} /></div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer-row">
        <strong>◒ {brandName}.</strong>
        <span>
          {
            locale === 'nl'
              ? ' Voor alles wat je voelt, maar nog niet kunt verwoorden.'
              : locale === 'ar'
                ? ' مساحة لما تشعر به ولا تستطيع وصفه بعد.'
                : ' For everything you feel but cannot yet put into words.'
          }
        </span>
        <span>
          {
            locale === 'nl'
              ? 'Persoonlijk initiatief · conceptsite · beeld en content in ontwikkeling'
              : locale === 'ar'
                ? 'مبادرة شخصية · موقع تجريبي · الصور والمحتوى قيد التطوير'
                : 'Personal initiative · concept site · visuals and content in development'
          }
        </span>
        <small>
          {
            locale === 'nl'
              ? 'Voorbeelden en begrippen helpen patronen verkennen; ze zijn geen diagnose of oordeel over iemand.'
              : locale === 'ar'
                ? 'تساعد الأمثلة والمفاهيم على استكشاف الأنماط؛ وهي ليست تشخيصاً أو حكماً على أي شخص.'
                : 'Examples and concepts help explore patterns; they are not a diagnosis or a judgement about anyone.'
          }
        </small>
      </div>
    </footer>
    <ThemeToggle locale={locale} />
  </body>
</html>
