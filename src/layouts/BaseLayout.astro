---
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '../styles/global.css';
import '../styles/print.css';
import { type Locale } from '../i18n/config';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ui } from '../i18n/ui';
import { hasPhotos } from '../lib/photos';
import { shareImage } from '../lib/site';
import { markReview } from '../lib/review-marks';
import { currentTab, isMenuCurrent, mainMenu, navigationFor, sectionFor } from '../lib/navigation';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  indexable?: boolean;
  alternates?: Array<{ locale: Locale; path: string }>;
  /** Additional JSON-LD nodes; they must describe content that is visible on the page. */
  schema?: Array<Record<string, unknown>>;
  /** Visible page heading, when it differs from the document title. */
  schemaName?: string;
  /** @id of the node that is the main content of this page. */
  mainEntityId?: string;
  /** Sources visible on the page. */
  citations?: Array<Record<string, unknown>>;
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage';
}
const {
  title,
  description,
  locale = 'nl',
  canonicalPath = '/',
  indexable = true,
  alternates = [],
  schema: extraSchema = [],
  schemaName,
  mainEntityId,
  citations = [],
  pageType = 'WebPage',
} = Astro.props;
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localPath = canonicalPath.replace(/^\//, '');
const canonical = new URL(`${basePath}${localPath}`, site).href;
const alternateUrls = alternates.map(({ locale: alternateLocale, path }) => ({
  locale: alternateLocale,
  href: new URL(`${basePath}${path.replace(/^\//, '')}`, site).href,
}));
const defaultAlternate = alternateUrls.find(
  ({ locale: alternateLocale }) => alternateLocale === 'nl',
);
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const brandName = locale === 'nl' ? 'Ongehoord' : 'Unheard';
const siteRoot = new URL(basePath, site).href;
const websiteId = `${siteRoot}#website`;
const organizationId = `${siteRoot}#organization`;
const logoUrl = new URL(`${basePath}logo.svg`, site).href;
const organizationDescription =
  locale === 'nl'
    ? 'Voor alles wat je voelt, maar nog niet kunt verwoorden. Een persoonlijk initiatief van één persoon, geen hulporganisatie.'
    : locale === 'ar'
      ? 'مساحة لما تشعر به ولا تستطيع وصفه بعد.'
      : 'For everything you feel but cannot yet put into words.';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: brandName,
      description: organizationDescription,
      url: siteRoot,
      logo: { '@type': 'ImageObject', url: logoUrl, width: 256, height: 256 },
      image: new URL(`${basePath}${shareImage.path}`, site).href,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: brandName,
      url: siteRoot,
      inLanguage: 'nl',
      publisher: { '@id': organizationId },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteRoot}nl/zoeken/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': ['WebPage', pageType].filter((type, index, all) => all.indexOf(type) === index),
      '@id': canonical,
      name: schemaName || title,
      description,
      inLanguage: locale,
      url: canonical,
      isPartOf: { '@id': websiteId },
      creativeWorkStatus: 'Conceptversie',
      ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
      ...(citations.length > 0 ? { citation: citations } : {}),
    },
    ...extraSchema,
  ],
};
const schemaJson = JSON.stringify(schema).replaceAll('<', '\\u003c');
const noIndex = process.env.NO_INDEX === 'true' || !indexable;
const cloudflareBeaconToken = import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN;
const skipLabel =
  locale === 'nl'
    ? 'Direct naar inhoud'
    : locale === 'ar'
      ? 'انتقل إلى المحتوى'
      : 'Skip to content';
const homeHref = `${locale}/`;
const t = ui(locale);
const siteNavigation = navigationFor(locale);
const navigation: Array<[string, string]> = siteNavigation
  ? mainMenu(siteNavigation).map(({ href, label }) => [href, label])
  : [[homeHref, t.home]];
const isCurrent = (href: string) =>
  siteNavigation
    ? isMenuCurrent(siteNavigation, href, localPath)
    : href === homeHref && localPath === homeHref;
const activeSection = siteNavigation ? sectionFor(siteNavigation, localPath) : undefined;
const activeTab = activeSection ? currentTab(activeSection, localPath) : undefined;
const navLabel = t.mainNavigation;
const footerGroups =
  locale === 'nl'
    ? [
        {
          heading: 'Ontdek',
          links: [
            ['nl/wat-voel-ik/', 'Wat voel ik?'],
            ['nl/begrijp-het/', 'Begrijp het'],
            ['nl/begrippen/', 'Begrippen van A tot Z'],
            ['nl/herstel/', 'Herstel'],
            ['nl/hulpmiddelen/', 'Hulpmiddelen'],
            ['nl/mannen-in-cijfers/', 'Mannen in cijfers'],
            ['nl/zoeken/', 'Zoeken'],
          ],
        },
        {
          heading: 'Over deze site',
          links: [
            ['nl/over/', 'Over Ongehoord'],
            ['nl/werkwijze/', 'Werkwijze en bronnen'],
            ['nl/veilig-gebruik/', 'Privacy en veilig gebruik'],
            ['nl/toegankelijkheid/', 'Toegankelijkheid'],
            ['nl/ik-maak-me-zorgen-om-iemand/', 'Voor naasten'],
          ],
        },
      ]
    : [];
---

<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={`${title} — ${brandName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${basePath}${shareImage.path}`, site).href} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content="Ongehoord: Je hoeft het nog geen misbruik te noemen." />
    <meta
      property="og:locale"
      content={locale === 'nl' ? 'nl_NL' : locale === 'ar' ? 'ar' : 'en_GB'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <base href={basePath} />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {
      alternateUrls.map(({ locale: alternateLocale, href }) => (
        <link rel="alternate" hreflang={alternateLocale} href={href} />
      ))
    }
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    <script type="application/ld+json" set:html={schemaJson} />
    {
      cloudflareBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken, spa: false })}
        />
      )
    }
    <title>{title} — {brandName}</title>
    <script
      is:inline
      set:html={`(()=>{try{const t=localStorage.getItem('ongehoord-theme');const d=t==='dark'||t==='light'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d}catch{}if(/[?&]review(?:=|&|$)/.test(location.search))document.documentElement.classList.add('show-review')})()`}
    />
  </head>
  <body>
    <a class="skip" href={`${localPath}#main`}>{skipLabel}</a>
    <div class="safety-dock">
      <ThemeToggle locale={locale} />
      <a class="safe-exit" data-safe-exit href="https://www.knmi.nl" rel="noreferrer"
        >Verlaat site</a
      >
    </div>
    <p class="site-notice">
      Deze site is een conceptversie en is nog niet inhoudelijk gecontroleerd. Lees haar als
      oriëntatie, niet als advies.
    </p>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={`${locale}/`}>{brandName}<span>.</span></a>
        <nav class="nav" aria-label={navLabel}>
          {
            navigation.map(([href, label]) => (
              <a
                class:list={{
                  'nav-home': href === homeHref,
                  'nav-help': href === siteNavigation?.help.href,
                }}
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
        {
          locale === 'nl' && (
            <a class="header-search" href="nl/zoeken/" aria-label={t.search} title={t.search}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <>
                  <circle cx="11" cy="11" r="6.5" />
                  <path d="m16 16 4.5 4.5" />
                </>
              </svg>
            </a>
          )
        }
        <details class="mobile-menu">
          <summary aria-label={t.openMenu}>
            <span></span><span></span><span></span>
          </summary>
          <nav class="mobile-menu__panel" aria-label={`${navLabel} (mobiel)`}>
            {
              navigation.map(([href, label]) => (
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {label}
                </a>
              ))
            }
            {
              activeSection &&
                activeSection.tabs.map(({ href, label }) => (
                  <a
                    class="mobile-menu__sub"
                    href={href}
                    aria-current={activeTab?.href === href ? 'page' : undefined}
                  >
                    {label}
                  </a>
                ))
            }
            {locale === 'nl' && <a href="nl/zoeken/">{t.search}</a>}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" set:html={markReview(await Astro.slots.render('default'))} />
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="footer-brand">{brandName}<span>.</span></p>
            <p class="footer-warm">{t.warmLine}</p>
            {
              locale === 'nl' ? (
                <>
                  <p>
                    Voor alles wat je voelt, maar nog niet kunt verwoorden. Een persoonlijk
                    initiatief van één persoon, geen hulporganisatie.
                  </p>
                  <ul class="footer-help">
                    <li>
                      Direct gevaar? Bel <a href="tel:112">112</a>.
                    </li>
                    <li>Zorgen over huiselijk geweld?</li>
                    <li>
                      Veilig Thuis <a href="tel:08002000">0800-2000</a>.
                    </li>
                    <li>
                      <a href="nl/hulp-vinden/">Alle hulp</a>
                    </li>
                  </ul>
                </>
              ) : (
                <p>
                  {locale === 'ar'
                    ? 'مساحة لما تشعر به ولا تستطيع وصفه بعد.'
                    : 'For everything you feel but cannot yet put into words.'}
                </p>
              )
            }
          </div>
          {
            footerGroups.map((group) => (
              <nav aria-label={group.heading}>
                <h2>{group.heading}</h2>
                <ul>
                  {group.links.map(([href, label]) => (
                    <li>
                      <a href={href}>{label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
        <p class="footer-meta">
          {
            locale === 'nl'
              ? `Conceptsite in ontwikkeling. Voorbeelden en begrippen helpen patronen verkennen; ze zijn geen diagnose of oordeel over iemand.${hasPhotos ? ' De foto’s op deze site zijn met AI gemaakt.' : ''}`
              : locale === 'ar'
                ? 'موقع تجريبي قيد التطوير.'
                : 'Concept site in development.'
          }
        </p>
      </div>
    </footer>
    <script>
      const exit = document.querySelector<HTMLAnchorElement>('[data-safe-exit]');
      const leave = () => {
        if (exit) window.location.replace(exit.href);
      };
      exit?.addEventListener('click', (event) => {
        event.preventDefault();
        leave();
      });
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            leave();
          }
        },
        { capture: true },
      );
    </script>
    <script
      is:inline
      set:html={`addEventListener('beforeprint',()=>{document.querySelectorAll('main details:not([open])').forEach(d=>{d.dataset.printName=d.name||'';d.name='';d.open=true})});addEventListener('afterprint',()=>{document.querySelectorAll('main details[data-print-name]').forEach(d=>{d.open=false;d.name=d.dataset.printName;delete d.dataset.printName})})`}
    />
  </body>
</html>
