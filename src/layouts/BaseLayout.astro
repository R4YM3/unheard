---
import '../styles/fonts.css';
import headingFont from '@fontsource/fraunces/files/fraunces-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import menuFont from '@fontsource/source-sans-3/files/source-sans-3-latin-600-normal.woff2?url';
import DesktopNavSection from '../components/DesktopNavSection.astro';
import '../styles/global.css';
import '../styles/print.css';
import { isPublicLocale, type Locale } from '../i18n/config';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ui } from '../i18n/ui';
import { hasPhotos } from '../lib/photos';
import { shareImage } from '../lib/site';
import { markReview } from '../lib/review-marks';
import { currentTab, isMenuCurrent, mainMenu, navigationFor, sectionFor } from '../lib/navigation';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  indexable?: boolean;
  alternates?: Array<{ locale: Locale; path: string }>;
  /** Additional JSON-LD nodes; they must describe content that is visible on the page. */
  schema?: Array<Record<string, unknown>>;
  /** Visible page heading, when it differs from the document title. */
  schemaName?: string;
  /** @id of the node that is the main content of this page. */
  mainEntityId?: string;
  /** Sources visible on the page. */
  citations?: Array<Record<string, unknown>>;
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage';
}
const {
  title,
  description,
  locale = 'nl',
  canonicalPath = '/',
  indexable = true,
  alternates = [],
  schema: extraSchema = [],
  schemaName,
  mainEntityId,
  citations = [],
  pageType = 'WebPage',
} = Astro.props;
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localPath = canonicalPath.replace(/^\//, '');
const canonical = new URL(`${basePath}${localPath}`, site).href;
const alternateUrls = alternates.map(({ locale: alternateLocale, path }) => ({
  locale: alternateLocale,
  href: new URL(`${basePath}${path.replace(/^\//, '')}`, site).href,
}));
const defaultAlternate = alternateUrls.find(
  ({ locale: alternateLocale }) => alternateLocale === 'nl',
);
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const brandName = locale === 'nl' ? 'Ongehoord' : 'Unheard';
const siteRoot = new URL(basePath, site).href;
const websiteId = `${siteRoot}#website`;
const organizationId = `${siteRoot}#organization`;
const logoUrl = new URL(`${basePath}logo.svg`, site).href;
const t = ui(locale);
const organizationDescription = t.brandDescription;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: brandName,
      description: organizationDescription,
      url: siteRoot,
      logo: { '@type': 'ImageObject', url: logoUrl, width: 256, height: 256 },
      image: new URL(`${basePath}${shareImage.path}`, site).href,
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: brandName,
      url: siteRoot,
      inLanguage: 'nl',
      publisher: { '@id': organizationId },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteRoot}nl/zoeken/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': ['WebPage', pageType].filter((type, index, all) => all.indexOf(type) === index),
      '@id': canonical,
      name: schemaName || title,
      description,
      inLanguage: locale,
      url: canonical,
      isPartOf: { '@id': websiteId },
      creativeWorkStatus: t.draftStatus,
      ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
      ...(citations.length > 0 ? { citation: citations } : {}),
    },
    ...extraSchema,
  ],
};
const schemaJson = JSON.stringify(schema).replaceAll('<', '\\u003c');
/* A locale without an approved translation is built for review only and never indexed. */
const noIndex = process.env.NO_INDEX === 'true' || !indexable || !isPublicLocale(locale);
const cloudflareBeaconToken = import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN;
const skipLabel = t.skipToContent;
const homeHref = `${locale}/`;
const siteNavigation = navigationFor(locale);
const navigation: Array<[string, string]> = siteNavigation
  ? mainMenu(siteNavigation).map(({ href, label }) => [href, label])
  : [[homeHref, t.home]];
/* aria-current="page" only on the page itself; the active section is a visual cue (.is-active). */
const isPage = (href: string) => href === localPath;
const isCurrent = (href: string) =>
  siteNavigation
    ? isMenuCurrent(siteNavigation, href, localPath)
    : href === homeHref && localPath === homeHref;
const helpHref = siteNavigation?.help.href;
const activeSection = siteNavigation ? sectionFor(siteNavigation, localPath) : undefined;
const activeTab = activeSection ? currentTab(activeSection, localPath) : undefined;
const navLabel = t.mainNavigation;
const footerGroups = siteNavigation?.footer ?? [];
/* hreflang only between locales that are public. */
const publicAlternates = isPublicLocale(locale)
  ? alternateUrls.filter(({ locale: alternateLocale }) => isPublicLocale(alternateLocale))
  : [];
---

<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    {
      [headingFont, bodyFont, menuFont].map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin="anonymous" />
      ))
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={`${title} — ${brandName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${basePath}${shareImage.path}`, site).href} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:image:alt" content={t.shareImageAlt} />
    <meta
      property="og:locale"
      content={locale === 'nl' ? 'nl_NL' : locale === 'ar' ? 'ar' : 'en_GB'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <base href={basePath} />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {
      publicAlternates.map(({ locale: alternateLocale, href }) => (
        <link rel="alternate" hreflang={alternateLocale} href={href} />
      ))
    }
    {
      publicAlternates.length > 0 && defaultAlternate && (
        <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
      )
    }
    <script type="application/ld+json" set:html={schemaJson} />
    {
      cloudflareBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken, spa: false })}
        />
      )
    }
    <title>{title} — {brandName}</title>
    <script
      is:inline
      set:html={`(()=>{try{const t=localStorage.getItem('ongehoord-theme');const d=t==='dark'||t==='light'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d}catch{}if(/[?&]review(?:=|&|$)/.test(location.search))document.documentElement.classList.add('show-review')})()`}
    />
  </head>
  <body>
    <a class="skip" href={`${localPath}#main`}>{skipLabel}</a>
    <div class="safety-dock">
      <ThemeToggle locale={locale} />
      <a class="safe-exit" data-safe-exit href="https://www.knmi.nl" rel="noreferrer"
        >{t.safeExit}</a
      >
    </div>
    <p class="site-notice">{t.siteNotice}</p>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={`${locale}/`}>{brandName}<span>.</span></a>
        <nav class="nav" aria-label={navLabel}>
          {
            navigation.map(([href, label]) => {
              const section = siteNavigation?.sections.find((item) => item.menu.href === href);
              return section ? (
                <DesktopNavSection
                  section={section}
                  current={isCurrent(href)}
                  currentPath={localPath}
                />
              ) : (
                <a
                  class:list={{
                    'nav-home': href === homeHref,
                    'nav-help': href === helpHref,
                    'is-active': isCurrent(href),
                  }}
                  href={href}
                  aria-current={isPage(href) ? 'page' : undefined}
                >
                  {label}
                </a>
              );
            })
          }
        </nav>
        {
          locale === 'nl' && (
            <a class="header-search" href="nl/zoeken/" aria-label={t.search} title={t.search}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <>
                  <circle cx="11" cy="11" r="6.5" />
                  <path d="m16 16 4.5 4.5" />
                </>
              </svg>
            </a>
          )
        }
        {
          helpHref && (
            <a
              class:list={['header-help', { 'is-active': isCurrent(helpHref) }]}
              href={helpHref}
              aria-current={isPage(helpHref) ? 'page' : undefined}
            >
              {siteNavigation?.help.label}
            </a>
          )
        }
        <details class="mobile-menu" data-mobile-menu>
          <summary
            aria-label={t.openMenu}
            data-label-open={t.openMenu}
            data-label-close={t.closeMenu}
          >
            <span></span><span></span><span></span>
          </summary>
          <nav class="mobile-menu__panel" aria-label={`${navLabel} ${t.mobileSuffix}`}>
            <a
              class="safe-exit mobile-menu__exit"
              data-safe-exit
              href="https://www.knmi.nl"
              rel="noreferrer">{t.safeExit}</a
            >
            {
              helpHref && (
                <div class="mobile-menu__help">
                  <p class="mobile-menu__help-title">{t.helpNow}</p>
                  <div class="mobile-menu__help-lines">
                    <a href="tel:112">
                      <span>{t.helpDanger}</span>
                      <strong>112</strong>
                    </a>
                    <a href="tel:08002000">
                      <span>Veilig Thuis</span>
                      <strong>0800-2000</strong>
                    </a>
                  </div>
                  <a
                    class="mobile-menu__help-all"
                    href={helpHref}
                    aria-current={isPage(helpHref) ? 'page' : undefined}
                  >
                    {t.footerAllHelp} →
                  </a>
                </div>
              )
            }
            <ul class="mobile-menu__list">
              {
                navigation
                  .filter(([href]) => href !== helpHref)
                  .map(([href, label]) => {
                    const section = siteNavigation?.sections.find(
                      (item) => item.menu.href === href,
                    );
                    const subs =
                      section && section === activeSection
                        ? section.tabs.filter((tab) => tab.href !== href)
                        : [];
                    return (
                      <li>
                        <a
                          class:list={{ 'is-active': isCurrent(href) }}
                          href={href}
                          aria-current={isPage(href) ? 'page' : undefined}
                        >
                          {label}
                        </a>
                        {subs.length > 0 && (
                          <ul>
                            {subs.map((tab) => (
                              <li>
                                <a
                                  class:list={[
                                    'mobile-menu__sub',
                                    { 'is-active': activeTab?.href === tab.href },
                                  ]}
                                  href={tab.href}
                                  aria-current={isPage(tab.href) ? 'page' : undefined}
                                >
                                  {tab.label}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    );
                  })
              }
              {
                locale === 'nl' && (
                  <li>
                    <a href="nl/zoeken/" aria-current={isPage('nl/zoeken/') ? 'page' : undefined}>
                      {t.search}
                    </a>
                  </li>
                )
              }
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main" set:html={markReview(await Astro.slots.render('default'))} />
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p class="footer-brand">{brandName}<span>.</span></p>
            <p class="footer-warm">{t.warmLine}</p>
            <p>{t.brandDescription}</p>
            {
              siteNavigation && (
                <ul class="footer-help">
                  <li>
                    {t.footerDanger} <a href="tel:112">112</a>.
                  </li>
                  <li>{t.footerWorried}</li>
                  <li>
                    Veilig Thuis <a href="tel:08002000">0800-2000</a>.
                  </li>
                  <li>
                    <a href={siteNavigation.help.href}>{t.footerAllHelp}</a>
                  </li>
                </ul>
              )
            }
          </div>
          {
            footerGroups.map((group) => (
              <nav aria-label={group.heading}>
                <h2>{group.heading}</h2>
                <ul>
                  {group.links.map(({ href, label }) => (
                    <li>
                      <a href={href}>{label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
        <p class="footer-meta">{t.footerMeta(hasPhotos)}</p>
      </div>
    </footer>
    <script>
      // 'Verlaat site' is a plain link; with JavaScript it also replaces this page in the history.
      for (const exit of document.querySelectorAll<HTMLAnchorElement>('[data-safe-exit]')) {
        exit.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          window.location.replace(exit.href);
        });
      }
      const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      const menuButton = menu?.querySelector<HTMLElement>('summary');
      const header = document.querySelector<HTMLElement>('.site-header');
      let scrollBefore: number | undefined;
      const syncMenu = () => {
        if (!menu || !menuButton) return;
        const label = menu.open ? menuButton.dataset.labelClose : menuButton.dataset.labelOpen;
        if (label) menuButton.setAttribute('aria-label', label);
        if (menu.open) {
          // On a short screen, let the sticky header reach the top so the panel gets the height.
          const headerTop = header?.getBoundingClientRect().top ?? 0;
          if (window.innerHeight < 480 && headerTop > 0) {
            scrollBefore = window.scrollY;
            window.scrollBy({ top: headerTop, behavior: 'instant' });
          }
          const box = menuButton.getBoundingClientRect();
          menu.style.setProperty('--menu-top', `${box.bottom}px`);
          menu.style.setProperty(
            '--menu-right',
            `${document.documentElement.clientWidth - box.right}px`,
          );
          menu.style.setProperty('--menu-left', `${box.left}px`);
        } else if (scrollBefore !== undefined) {
          window.scrollTo({ top: scrollBefore, behavior: 'instant' });
          scrollBefore = undefined;
        }
      };
      menu?.addEventListener('toggle', syncMenu);
      // With JavaScript the panel is fixed to the viewport: focusing a link in it then never
      // scrolls the page underneath.
      if (menu) menu.dataset.enhanced = '';
      document.addEventListener('click', (event) => {
        if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
      });
      // Escape closes the open menu and returns focus. It never leaves the site.
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        // Escape keeps what someone typed: browsers otherwise empty a search field.
        if (event.target instanceof HTMLInputElement && event.target.type === 'search') {
          event.preventDefault();
        }
        if (!menu?.open || !menu.getClientRects().length) return;
        event.preventDefault();
        menu.open = false;
        menuButton?.focus({ preventScroll: true });
      });
    </script>
    <script
      is:inline
      set:html={`addEventListener('beforeprint',()=>{document.querySelectorAll('main details:not([open])').forEach(d=>{d.dataset.printName=d.name||'';d.name='';d.open=true})});addEventListener('afterprint',()=>{document.querySelectorAll('main details[data-print-name]').forEach(d=>{d.open=false;d.name=d.dataset.printName;delete d.dataset.printName})})`}
    />
  </body>
</html>
