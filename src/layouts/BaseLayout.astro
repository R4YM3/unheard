---
import '../styles/global.css';
import '../styles/print.css';
import { type Locale } from '../i18n/config';
import ThemeToggle from '../components/ThemeToggle.astro';
import LocaleSelector from '../components/LocaleSelector.astro';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  indexable?: boolean;
  alternates?: Array<{ locale: Locale; path: string }>;
  /** Additional JSON-LD nodes; they must describe content that is visible on the page. */
  schema?: Array<Record<string, unknown>>;
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage';
}
const {
  title,
  description,
  locale = 'nl',
  canonicalPath = '/',
  indexable = true,
  alternates = [],
  schema: extraSchema = [],
  pageType = 'WebPage',
} = Astro.props;
const site = Astro.site ?? new URL('https://r4ym3.github.io');
const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const localPath = canonicalPath.replace(/^\//, '');
const canonical = new URL(`${basePath}${localPath}`, site).href;
const alternateUrls = alternates.map(({ locale: alternateLocale, path }) => ({
  locale: alternateLocale,
  href: new URL(`${basePath}${path.replace(/^\//, '')}`, site).href,
}));
const defaultAlternate = alternateUrls.find(
  ({ locale: alternateLocale }) => alternateLocale === 'nl',
);
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const brandName = locale === 'nl' ? 'Ongehoord' : 'Unheard';
const siteRoot = new URL(basePath, site).href;
const websiteId = `${siteRoot}#website`;
const organizationId = `${siteRoot}#organization`;
const logoUrl = new URL(`${basePath}logo.svg`, site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: 'Ongehoord',
    url: siteRoot,
    logo: { '@type': 'ImageObject', url: logoUrl, width: 256, height: 256 },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': websiteId,
    name: brandName,
    url: siteRoot,
    inLanguage: locale,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': ['WebPage', pageType].filter((type, index, all) => all.indexOf(type) === index),
    '@id': canonical,
    name: title,
    description,
    inLanguage: locale,
    url: canonical,
    isPartOf: { '@id': websiteId },
  },
  ...extraSchema.map((node) => ({ '@context': 'https://schema.org', ...node })),
];
const noIndex = process.env.NO_INDEX === 'true' || !indexable;
const cloudflareBeaconToken = import.meta.env.PUBLIC_CLOUDFLARE_BEACON_TOKEN;
const skipLabel =
  locale === 'nl'
    ? 'Direct naar inhoud'
    : locale === 'ar'
      ? 'انتقل إلى المحتوى'
      : 'Skip to content';
const homeHref = `${locale}/`;
const navigation: Array<[string, string]> =
  locale === 'nl'
    ? [
        [homeHref, 'Home'],
        ['nl/wat-voel-ik/', 'Wat voel ik?'],
        ['nl/begrijp-het/', 'Begrijp het'],
        ['nl/herstel/', 'Herstel'],
        ['nl/mijn-verhaal/', 'Mijn verhaal'],
        ['nl/hulpmiddelen/', 'Hulpmiddelen'],
        ['nl/hulp-vinden/', 'Hulp vinden'],
      ]
    : [[homeHref, locale === 'ar' ? 'الصفحة الرئيسية' : 'Home']];
const isCurrent = (href: string) => {
  if (href === homeHref) return localPath === homeHref;
  if (href === 'nl/begrijp-het/')
    return localPath.startsWith(href) || localPath.startsWith('nl/begrippen/');
  return localPath.startsWith(href);
};
const sectionGroups =
  locale === 'nl'
    ? [
        {
          test: localPath.startsWith('nl/wat-voel-ik'),
          label: 'Binnen Wat voel ik?',
          links: [
            ['nl/wat-voel-ik/', 'Alle gevoelens'],
            ['nl/wat-voel-ik/ik-twijfel-aan-mezelf/', 'Twijfel'],
            ['nl/wat-voel-ik/ik-voel-me-schuldig/', 'Schuld'],
            ['nl/wat-voel-ik/ik-herken-mezelf-niet-meer/', 'Identiteit'],
            ['nl/wat-voel-ik/ik-durf-geen-nee-te-zeggen/', 'Grenzen'],
            ['nl/wat-voel-ik/ik-durf-niet-over-geld-te-praten/', 'Geld'],
            ['nl/wat-voel-ik/ik-begrijp-het-maar-het-blijft-pijn-doen/', 'Het blijft pijn doen'],
          ] as Array<[string, string]>,
        },
        {
          test: localPath.startsWith('nl/begrijp-het') || localPath.startsWith('nl/begrippen'),
          label: 'Binnen Begrijp het',
          links: [
            ['nl/begrijp-het/', 'Overzicht'],
            ['nl/begrijp-het/emotioneel-misbruik/', 'Emotioneel misbruik'],
            ['nl/begrijp-het/financieel-misbruik/', 'Financieel misbruik'],
            ['nl/begrippen/', 'Begrippen A–Z'],
            ['nl/begrippen/silent-treatment/', 'Silent treatment'],
            ['nl/begrippen/gaslighting/', 'Gaslighting'],
            ['nl/begrippen/darvo/', 'DARVO'],
            ['nl/begrippen/hoovering/', 'Hoovering'],
          ] as Array<[string, string]>,
        },
        {
          test: localPath.startsWith('nl/herstel') || localPath.startsWith('nl/hulpmiddelen'),
          label: 'Binnen Herstel',
          links: [
            ['nl/herstel/', 'Overzicht'],
            ['nl/herstel/therapievormen/', 'Therapievormen'],
            ['nl/herstel/therapievormen/schematherapie/', 'Schematherapie'],
            ['nl/hulpmiddelen/', 'Hulpmiddelen'],
          ] as Array<[string, string]>,
        },
      ]
    : [];
const activeSection = sectionGroups.find((group) => group.test);
const navLabel =
  locale === 'ar' ? 'التنقل الرئيسي' : locale === 'en' ? 'Main navigation' : 'Hoofdnavigatie';
const footerGroups =
  locale === 'nl'
    ? [
        {
          heading: 'Ontdek',
          links: [
            ['nl/wat-voel-ik/', 'Wat voel ik?'],
            ['nl/begrijp-het/', 'Begrijp het'],
            ['nl/begrippen/', 'Begrippen van A tot Z'],
            ['nl/herstel/', 'Herstel'],
            ['nl/hulpmiddelen/', 'Hulpmiddelen'],
            ['nl/mannen-in-cijfers/', 'Mannen in cijfers'],
            ['nl/zoeken/', 'Zoeken'],
          ],
        },
        {
          heading: 'Over deze site',
          links: [
            ['nl/over/', 'Over Ongehoord'],
            ['nl/werkwijze/', 'Werkwijze en bronnen'],
            ['nl/veilig-gebruik/', 'Privacy en veilig gebruik'],
            ['nl/toegankelijkheid/', 'Toegankelijkheid'],
            ['nl/ik-maak-me-zorgen-om-iemand/', 'Voor naasten'],
          ],
        },
      ]
    : [];
---

<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={`${title} — ${brandName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <base href={basePath} />
    <link rel="icon" href={`${basePath}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {
      alternateUrls.map(({ locale: alternateLocale, href }) => (
        <link rel="alternate" hreflang={alternateLocale} href={href} />
      ))
    }
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {
      cloudflareBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareBeaconToken, spa: false })}
        />
      )
    }
    <title>{title} — {brandName}</title>
    <script
      is:inline
      set:html={`(()=>{try{const t=localStorage.getItem('ongehoord-theme');const d=t==='dark'||t==='light'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d}catch{}})()`}
    />
  </head>
  <body>
    <a class="skip" href={`${localPath}#main`}>{skipLabel}</a>
    <p class="site-notice">
      Deze site is een conceptversie en is nog niet inhoudelijk gecontroleerd. Lees haar als
      oriëntatie, niet als advies.
    </p>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={`${locale}/`}>{brandName}<span>.</span></a>
        <nav class="nav" aria-label={navLabel}>
          {
            navigation.map(([href, label]) => (
              <a
                class:list={{
                  'nav-home': href === homeHref,
                  'nav-help': href === 'nl/hulp-vinden/',
                }}
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <details class="mobile-menu">
          <summary
            aria-label={locale === 'nl'
              ? 'Menu openen'
              : locale === 'ar'
                ? 'فتح القائمة'
                : 'Open menu'}
          >
            <span></span><span></span><span></span>
          </summary>
          <nav class="mobile-menu__panel" aria-label={`${navLabel} (mobiel)`}>
            {
              navigation.map(([href, label]) => (
                <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                  {label}
                </a>
              ))
            }
            {
              activeSection &&
                activeSection.links.map(([href, label]) => (
                  <a class="mobile-menu__sub" href={href}>
                    {label}
                  </a>
                ))
            }
            {locale === 'nl' && <a href="nl/zoeken/">Zoeken</a>}
          </nav>
        </details>
        <div class="header-controls"><LocaleSelector locale={locale} /></div>
      </div>
    </header>
    {
      activeSection && (
        <div class="section-nav-bar">
          <div class="wrap">
            <nav class="section-nav" aria-label={activeSection.label}>
              <ul>
                {activeSection.links.map(([href, label]) => (
                  <li>
                    <a href={href} aria-current={localPath === href ? 'page' : undefined}>
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </div>
      )
    }
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <p><strong>◒ {brandName}.</strong></p>
            {
              locale === 'nl' ? (
                <>
                  <p>
                    Voor alles wat je voelt, maar nog niet kunt verwoorden. Een persoonlijk
                    initiatief van één persoon, geen hulporganisatie.
                  </p>
                  <p class="footer-help">
                    Direct gevaar? Bel <a href="tel:112">112</a>. Zorgen over huiselijk geweld?
                    Veilig Thuis <a href="tel:08002000">0800-2000</a>.{' '}
                    <a href="nl/hulp-vinden/">Alle hulp</a>
                  </p>
                </>
              ) : (
                <p>
                  {locale === 'ar'
                    ? 'مساحة لما تشعر به ولا تستطيع وصفه بعد.'
                    : 'For everything you feel but cannot yet put into words.'}
                </p>
              )
            }
          </div>
          {
            footerGroups.map((group) => (
              <nav aria-label={group.heading}>
                <h2>{group.heading}</h2>
                <ul>
                  {group.links.map(([href, label]) => (
                    <li>
                      <a href={href}>{label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
        <p class="footer-meta">
          {
            locale === 'nl'
              ? 'Conceptsite in ontwikkeling. Voorbeelden en begrippen helpen patronen verkennen; ze zijn geen diagnose of oordeel over iemand.'
              : locale === 'ar'
                ? 'موقع تجريبي قيد التطوير.'
                : 'Concept site in development.'
          }
        </p>
      </div>
    </footer>
    <ThemeToggle locale={locale} />
    <script
      is:inline
      set:html={`addEventListener('beforeprint',()=>{document.querySelectorAll('main details:not([open])').forEach(d=>{d.dataset.printName=d.name||'';d.name='';d.open=true})});addEventListener('afterprint',()=>{document.querySelectorAll('main details[data-print-name]').forEach(d=>{d.open=false;d.name=d.dataset.printName;delete d.dataset.printName})})`}
    />
  </body>
</html>
