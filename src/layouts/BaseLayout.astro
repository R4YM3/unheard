---
import '../styles/global.css';
import '../styles/print.css';
import { localeNames, type Locale } from '../i18n/config';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props { title: string; description: string; locale?: Locale; canonicalPath?: string; }
const { title, description, locale = 'nl', canonicalPath = '/' } = Astro.props;
const site = new URL(import.meta.env.SITE ?? 'https://example.github.io');
const canonical = new URL(canonicalPath, site).href;
const dir = locale === 'ar' ? 'rtl' : 'ltr';
const schema = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, inLanguage: locale, url: canonical, isPartOf: { '@type': 'WebSite', name: 'Ongehoord', url: site.href } };
---
<!doctype html>
<html lang={locale} dir={dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title} — Ongehoord</title>
    <script is:inline>{`(()=>{try{const t=localStorage.getItem('ongehoord-theme');const d=t==='dark'||t==='light'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d}catch{}})()`}</script>
  </head>
  <body>
    <a class="skip" href="#main">Direct naar inhoud</a>
    <header class="site-header"><div class="wrap header-row">
      <a class="brand" href="/nl/">Ongehoord<span>.</span></a>
      <nav class="nav" aria-label="Hoofdnavigatie"><a href="/nl/wat-voel-ik/">Wat voel ik?</a><a href="/nl/begrippen/">Begrijp het</a><a href="/nl/herstel/">Herstel</a><a href="/nl/mijn-verhaal/">Mijn verhaal</a><a href="/nl/hulp-vinden/">Hulp vinden</a></nav>
      <span aria-label={`${localeNames[locale]}; andere talen volgen`}>NL</span><ThemeToggle />
    </div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="wrap"><strong>Ongehoord.</strong> Voor alles wat je voelt, maar nog niet kunt verwoorden.</div></footer>
    <script is:inline>{`document.addEventListener('click',e=>{const b=e.target.closest('[data-theme-toggle]');if(!b)return;const n=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=n;try{localStorage.setItem('ongehoord-theme',n)}catch{}})`}</script>
  </body>
</html>
