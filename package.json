{
  "name": "ongehoord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/audit-dist.mjs",
    "check": "astro check && npm run lint && npm run format:check && node scripts/validate-content.mjs && node --test test/**/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "astro preview",
    "audit:lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "audit:visual": "node scripts/visual-audit.mjs",
    "audit:a11y": "npm run build && node scripts/axe-audit.mjs",
    "audit:print": "npm run build && node scripts/print-audit.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.2",
    "yaml": "^2.9.1"
  }
}
